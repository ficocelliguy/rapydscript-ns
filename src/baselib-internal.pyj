# globals: exports, console, ρσ_iterator_symbol, ρσ_kwargs_symbol, ρσ_arraylike, ρσ_list_contains, ρσ_list_constructor, ρσ_str, ρσ_int, ρσ_float, ρσ_slice

# lst.append / s.upper / st.add read as a value: bind the builtin method to its
# receiver, as Python's bound methods do. Other values are returned unchanged.
v"""
function ρσ_attr_bind(obj, name) {
    var v = obj[name];
    if (typeof v !== "function" || typeof obj === "function" || ρσ_is_class_proto(obj)) return v;
    var builtin = v === Array.prototype[name] || v === String.prototype[name] || v === ρσ_str.prototype[name] ||
        v === ρσ_set.prototype[name] || v === ρσ_frozenset.prototype[name] ||
        v === ρσ_list_extend || v === ρσ_list_index || v === ρσ_list_pop || v === ρσ_list_remove ||
        v === ρσ_list_insert || v === ρσ_list_copy || v === ρσ_list_clear || v === ρσ_list_count ||
        v === ρσ_list_sort || v === ρσ_tuple_count || v === ρσ_tuple_index ||
        v === Array.prototype.push || v === Array.prototype.pop || v === Array.prototype.reverse;
    return builtin ? v.bind(obj) : v;
}
"""

# Unbound names: `del x` stores ρσ_unbound; reads that may find a name unbound
# go through ρσ_check_bound (see mark_unbound_reads in parse.pyj)
v"""
var ρσ_unbound = Object.freeze({toString: function () { return "<unbound>"; }});
function ρσ_del_name(value, name, kind) {
    ρσ_check_bound(value, name, kind);
    return ρσ_unbound;
}
function ρσ_check_bound(value, name, kind) {
    if (value === ρσ_unbound || (value === undefined && (kind === "local" || kind === "global"))) {
        if (kind === "local" || kind === "del_local") throw new UnboundLocalError("cannot access local variable '" + name + "' where it is not associated with a value");
        throw new ReferenceError("name '" + name + "' is not defined");
    }
    return value;
}
"""

def ρσ_eslice(arr, step, start, end):
    if jstype(arr) is 'string' or v'arr instanceof String':
        is_string = True
        arr = arr.split('')

    if step < 0:
        step = -step
        arr = arr.slice().reverse()
        if jstype(start) is not "undefined": start = arr.length - start - 1
        if jstype(end) is not "undefined": end = arr.length - end - 1
    if jstype(start) is "undefined": start = 0
    if jstype(end) is "undefined": end = arr.length

    is_tuple = arr.ρσ_is_tuple
    arr = Array.prototype.slice.call(arr, start, end).filter(def(e, i): return i % step is 0;)
    if is_string:
        arr = arr.join('')
    elif is_tuple:
        arr = ρσ_tuple_decorate(arr)  # a slice of a tuple is a tuple
    else:
        arr = ρσ_list_decorate(arr)
    return arr

def ρσ_delslice(arr, step, start, end):
    if jstype(arr) is 'string' or v'arr instanceof String':
        is_string = True
        arr = arr.split('')
    if step < 0:
        if jstype(start) is "undefined": start = arr.length
        if jstype(end) is "undefined": end = 0
        start, end, step = end, start, -step
    if jstype(start) is "undefined": start = 0
    if jstype(end) is "undefined": end = arr.length

    if step is 1:
        arr.splice(start, end - start)
    else:
        if end > start:
            indices = v'[]'
            for v'var i = start; i < end; i += step':
                indices.push(i)
            for v'var i = indices.length - 1; i >= 0; i--':
                arr.splice(indices[i], 1)

    if is_string:
        arr = arr.join('')
    return arr

def ρσ_flatten(arr):
    ans = []
    for v'var i=0; i < arr.length; i++':
        value = arr[i]  # noqa:undef
        if Array.isArray(value):
            ans = ans.concat(ρσ_flatten(value))
        else:
            ans.push(value)
    return ans

def ρσ_unpack_asarray(num, iterable):
    # a, b = iterable: Python requires exactly as many values as targets
    if ρσ_arraylike(iterable):
        ans = iterable
    else:
        ans = v'[]'
        if iterable is not None and iterable is not undefined and jstype(iterable[ρσ_iterator_symbol]) is 'function':
            iterator = iterable.keys() if jstype(Map) is 'function' and v'iterable instanceof Map' else iterable[ρσ_iterator_symbol]()
            result = iterator.next()
            while not result.done and ans.length <= num:  # one extra reveals "too many"
                ans.push(result.value)
                result = iterator.next()
        else:
            raise TypeError('cannot unpack non-iterable ' + ρσ_arith_type_name(iterable) + ' object')
    if ans.length > num:
        raise ValueError('too many values to unpack (expected ' + num + ')')
    if ans.length < num:
        raise ValueError('not enough values to unpack (expected ' + num + ', got ' + ans.length + ')')
    return ans

def ρσ_index_error(obj, key, assigning):
    # Python's IndexError for an out-of-range index on a list, tuple or str
    kind = 'string' if jstype(obj) is 'string' else ('tuple' if obj.ρσ_is_tuple else 'list')
    raise IndexError(kind + (' assignment' if assigning else '') + ' index out of range')

def ρσ_unpack_iter_check(value):
    # Raised when a for-loop tuple-unpacks a value that is a string. In Python,
    # iterating a dict yields its keys (strings); writing `for k, v in d:`
    # then tries to unpack each key character-by-character and raises
    # ValueError. JS strings are array-like, so without this check the
    # unpack silently succeeds with `k`/`v` set to individual characters.
    if jstype(value) is 'string' or v'value instanceof String':
        raise ValueError("cannot unpack string '" + value + "' into multiple values (did you mean to call .items() on a dict?)")
    return value

def ρσ_unpack_starred_asarray(iterable):
    if jstype(iterable) is 'string' or v'iterable instanceof String':
        return iterable.split('')
    if ρσ_arraylike(iterable):
        return iterable
    ans = v'[]'
    if jstype(iterable[ρσ_iterator_symbol]) is 'function':
        iterator = iterable.keys() if jstype(Map) is 'function' and v'iterable instanceof Map' else iterable[ρσ_iterator_symbol]()
        result = iterator.next()
        while not result.done:
            ans.push(result.value)
            result = iterator.next()
    return ans

def ρσ_next_method():
    # Bridge Python iterator protocol to JS iterator protocol. Installed as
    # `Cls.prototype.next` on classes that define `__next__`, so a Python-style
    # iterator (returning values from __next__, raising StopIteration to stop)
    # is consumable by everything that calls `.next()`: for...of, spread, list(),
    # tuple(), set(), iter(), and the ρσ_Iterable bridge.
    # Accepts both `raise StopIteration` (the class itself thrown) and
    # `raise StopIteration()` (an instance thrown) for Python compatibility.
    try:
        return v'{done: false, value: this.__next__()}'
    except as ρσ_e:
        if v'ρσ_e === StopIteration' or isinstance(ρσ_e, StopIteration):
            return v'{done: true, value: undefined}'
        raise

def ρσ_extends(child, parent):
    child.prototype = Object.create(parent.prototype)
    child.prototype.constructor = child
    Object.setPrototypeOf(child, parent)

def ρσ_object_new(cls):
    return v'Object.create(cls.prototype)'

def ρσ_new(parent, cls):
    if parent and jstype(parent.__new__) is 'function':
        return parent.__new__.apply(parent, v'Array.prototype.slice.call(arguments, 1)')
    return v'Object.create(cls.prototype)'

def ρσ_in(val, arr):
    if jstype(arr) is 'string':
        return arr.indexOf(val) is not -1
    if jstype(arr.__contains__) is 'function':
        return arr.__contains__(val)
    if jstype(Map) is 'function' and (v'arr instanceof Map' or v'arr instanceof Set'):
        return arr.has(val)
    if ρσ_arraylike(arr):
        return ρσ_list_contains.call(arr, val)
    if jstype(arr[ρσ_iterator_symbol]) is 'function' or jstype(arr.__getitem__) is 'function':
        # no __contains__: search what iterating the object yields
        for item in ρσ_Iterable(arr):
            if item is val or ρσ_equals(item, val):
                return True
        return False
    return Object.prototype.hasOwnProperty.call(arr, val)

def ρσ_Iterable(iterable):
    # Once ES6 is mature, change AST_ForIn to use the iterator protocol and get
    # rid of this function entirely
    if ρσ_arraylike(iterable):
        return iterable
    if jstype(iterable[ρσ_iterator_symbol]) is 'function':
        iterator = iterable.keys() if jstype(Map) is 'function' and v'iterable instanceof Map' else iterable[ρσ_iterator_symbol]()
        ans = []
        result = iterator.next()
        while not result.done:
            ans.push(result.value)
            result = iterator.next()
        return ans
    if jstype(iterable.__getitem__) is 'function':
        return ρσ_Iterable(ρσ_getitem_iterator(iterable))  # the old sequence protocol
    # so we can use 'for ... in' syntax with objects, as we would with dicts in python
    return Object.keys(iterable)

# Iterating an object that only defines __getitem__: items 0, 1, 2, ... until
# IndexError (or StopIteration), as Python's sequence iteration protocol
def ρσ_getitem_iterator(obj):
    ans = v'{"_i": 0, "_done": false}'
    ans[ρσ_iterator_symbol] = def():
        return this
    ans['next'] = def():
        if this._done:
            return v"{'done':true}"
        try:
            val = obj.__getitem__(this._i)
        except IndexError:
            this._done = True
            return v"{'done':true}"
        except StopIteration:
            this._done = True
            return v"{'done':true}"
        this._i += 1
        return v"{'done':false,'value':val}"
    return ans

def ρσ_desugar_kwargs():
    ans = Object.create(None)
    ans[ρσ_kwargs_symbol] = True
    for v'var i = 0; i < arguments.length; i++':
        arg = arguments[i]
        if v'arg && arg.jsmap && typeof arg.jsmap.forEach === "function"':
            v'arg.jsmap.forEach(function(v, k) { ans[k] = v; })'
        elif jstype(Object.assign) is 'function':
            Object.assign(ans, arg)
        else:
            keys = Object.keys(arg)
            for v'var j = 0; j < keys.length; j++':
                ans[keys[j]] = arg[keys[j]]
    return ans

# A method compiles to a function that takes `self` from `this`, but a Python
# decorator receives (and its wrapper calls) a function that takes `self` as
# its first argument. A decorated method is therefore compiled as
#   ρσ_method_from_func(decorator(ρσ_func_from_method(function m(x) {...})))

def ρσ_copy_func_props(src, dst, drop_first_argname):
    for name in Object.getOwnPropertyNames(src):
        if name is 'length' or name is 'name' or name is 'prototype' or name is 'arguments' or name is 'caller' or name is 'ρσ_method' or name is 'ρσ_self_is_this':
            continue
        if v'Object.prototype.hasOwnProperty.call(dst, name)':
            continue
        desc = Object.getOwnPropertyDescriptor(src, name)
        if name is '__argnames__' and Array.isArray(desc.value):
            desc.value = desc.value.slice(1) if drop_first_argname else ['self'].concat(desc.value)
        v'Object.defineProperty(dst, name, desc)'
    if src.name:
        v'Object.defineProperty(dst, "name", {value: src.name, configurable: true})'

def ρσ_func_from_method(m):
    f = v'function () { return m.apply(arguments[0], Array.prototype.slice.call(arguments, 1)); }'
    ρσ_copy_func_props(m, f, False)
    v'Object.defineProperty(f, "ρσ_method", {value: m})'
    return f

def ρσ_method_from_func(f):
    if jstype(f) is not 'function':
        return f  # e.g. a descriptor object; leave it to attribute lookup
    if f.ρσ_method:
        # The decorator returned the function it was given (it registered or
        # marked it): keep the original method, plus anything set on it.
        m = f.ρσ_method
        ρσ_copy_func_props(f, m, True)
        return m
    method = v'function () { return f.apply(this, [this].concat(Array.prototype.slice.call(arguments))); }'
    ρσ_copy_func_props(f, method, True)
    v'Object.defineProperty(method, "ρσ_self_is_this", {value: true})'
    return method

# ── Descriptors, property, delattr and metaclasses ──────────────────────────
v"""
function ρσ_is_class_proto(o) {
    return o !== null && typeof o === "object" && Object.prototype.hasOwnProperty.call(o, "constructor") && typeof o.constructor === "function" && o.constructor.prototype === o;
}

// A method (self is `this`) as a function taking self first
function ρσ_as_func(f) {
    if (typeof f === "function" && f.ρσ_self_is_this) return ρσ_func_from_method(f);
    return f;
}

function ρσ_define_deleter(proto, name, fn) {
    if (!Object.prototype.hasOwnProperty.call(proto, "ρσ_deleters")) {
        Object.defineProperty(proto, "ρσ_deleters", {value: Object.create(proto.ρσ_deleters || null), configurable: true});
    }
    proto.ρσ_deleters[name] = fn;
}

function ρσ_property(fget, fset, fdel, doc) {
    if (!(this instanceof ρσ_property)) return new ρσ_property(fget, fset, fdel, doc);
    this.fget = ρσ_as_func(fget === undefined ? null : fget);
    this.fset = ρσ_as_func(fset === undefined ? null : fset);
    this.fdel = ρσ_as_func(fdel === undefined ? null : fdel);
    this.__doc__ = (doc === undefined || doc === null) ? ((fget && fget.__doc__) || null) : doc;
    Object.defineProperty(this, "ρσ_name", {value: (fget && fget.name) || "", writable: true, configurable: true});
}
Object.defineProperty(ρσ_property, "__argnames__", {value: ["fget", "fset", "fdel", "doc"]});
ρσ_property.__name__ = ρσ_property.__qualname__ = "property";
ρσ_property.prototype.ρσ_missing = function (what) {
    return "property '" + this.ρσ_name + "' of '" + ((this.ρσ_owner && this.ρσ_owner.__name__) || "object") + "' object has no " + what;
};
ρσ_property.prototype.__get__ = function (obj, objtype) {
    if (obj === null || obj === undefined) return this;
    if (typeof this.fget !== "function") throw new AttributeError(this.ρσ_missing("getter"));
    return this.fget(obj);
};
ρσ_property.prototype.__set__ = function (obj, value) {
    if (typeof this.fset !== "function") throw new AttributeError(this.ρσ_missing("setter"));
    this.fset(obj, value);
};
ρσ_property.prototype.__delete__ = function (obj) {
    if (typeof this.fdel !== "function") throw new AttributeError(this.ρσ_missing("deleter"));
    this.fdel(obj);
};
ρσ_property.prototype.__set_name__ = function (owner, name) {
    this.ρσ_name = name;
    Object.defineProperty(this, "ρσ_owner", {value: owner, configurable: true, writable: true});
};
ρσ_property.prototype.getter = function (f) { return ρσ_property(f, this.fset, this.fdel, this.__doc__); };
ρσ_property.prototype.setter = function (f) { return ρσ_property(this.fget, f, this.fdel, this.__doc__); };
ρσ_property.prototype.deleter = function (f) { return ρσ_property(this.fget, this.fset, f, this.__doc__); };
ρσ_property.prototype.__repr__ = function () { return "<property object>"; };
ρσ_property.prototype.__str__ = ρσ_property.prototype.__repr__;

// Class variables holding descriptors (objects with __get__/__set__/__delete__)
// become accessors on the prototype; __set_name__ is called on every class
// variable that has one, as type.__new__ does.
function ρσ_install_descriptors(cls) {
    var proto = cls.prototype;
    if (!proto) return;
    var names = Object.getOwnPropertyNames(proto);
    for (var i = 0; i < names.length; i++) {
        var name = names[i];
        if (name === "constructor" || name === "__bases__") continue;
        var d = Object.getOwnPropertyDescriptor(proto, name);
        if (!d || !("value" in d)) continue;
        var v = d.value;
        if (v === null || typeof v !== "object" || Array.isArray(v)) continue;
        var has_get, has_set, has_del, set_name;
        try {
            has_get = typeof v.__get__ === "function";
            has_set = typeof v.__set__ === "function";
            has_del = typeof v.__delete__ === "function";
            set_name = v.__set_name__;
        } catch (e) { continue; }
        if (typeof set_name === "function") v.__set_name__(cls, name);
        if (!has_get && !has_set && !has_del) continue;
        ρσ_install_descriptor(proto, name, v, d.enumerable);
        if (has_del) ρσ_define_deleter(proto, name, ρσ_descriptor_deleter(v));
    }
}

function ρσ_descriptor_deleter(v) {
    return function () { v.__delete__(this); };
}

function ρσ_install_descriptor(proto, name, v, enumerable) {
    Object.defineProperty(proto, name, {
        enumerable: enumerable,
        configurable: true,
        get: function () {
            if (typeof v.__get__ !== "function") return v;
            if (ρσ_is_class_proto(this)) return v.__get__(null, this.constructor);
            return v.__get__(this, this.constructor);
        },
        set: function (value) {
            if (typeof v.__set__ === "function" && !ρσ_is_class_proto(this)) v.__set__(this, value);
            else Object.defineProperty(this, name, {value: value, writable: true, enumerable: true, configurable: true});
        }
    });
}

function ρσ_delattr(obj, name) {
    if (obj === null || obj === undefined) throw new AttributeError("'NoneType' object has no attribute '" + name + "'");
    if (typeof obj.__delattr__ === "function") {
        delete obj[name];
        return;
    }
    var deleters = obj.ρσ_deleters;
    if (deleters && typeof deleters[name] === "function") {
        deleters[name].call(obj);
        return;
    }
    if (Object.prototype.hasOwnProperty.call(obj, name)) {
        if (!delete obj[name]) throw new AttributeError("cannot delete attribute '" + name + "'");
        return;
    }
    if (typeof obj === "function" && obj.prototype && Object.prototype.hasOwnProperty.call(obj.prototype, name)) {
        delete obj.prototype[name];
        return;
    }
    var tname = (typeof obj === "function" && obj.__name__) ? "type object '" + obj.__name__ + "'" : "'" + ρσ_type(obj).__name__ + "' object";
    if (name in Object(obj)) throw new AttributeError(tname + " attribute '" + name + "' cannot be deleted");
    throw new AttributeError(tname + " has no attribute '" + name + "'");
}

// Metaclasses. class C(metaclass=M) is still a JS constructor; once it exists,
// M.__new__ and M.__init__ run with (name, bases, namespace), M's methods are
// reachable from C (and its subclasses), and isinstance(C, M) / type(C) work.
var ρσ_pending_class = null;

// A metaclass's __call__ runs instead of the constructor (classes compiled
// with a metaclass check ρσ_mcall first); type.__call__ then builds the
// instance, with ρσ_meta_bypass letting that one construction through.
var ρσ_meta_bypass = null;

function ρσ_meta_enter(cls, self) {
    if (ρσ_meta_bypass === cls) {
        if (self instanceof cls) ρσ_meta_bypass = null;
        return false;
    }
    return true;
}

function ρσ_meta_call(cls, args) {
    return cls.ρσ_metaclass.prototype.__call__.apply(cls, args);
}

function ρσ_class_namespace(cls) {
    var ns = ρσ_dict(), proto = cls.prototype;
    ns.jsmap.set("__module__", cls.__module__);
    ns.jsmap.set("__qualname__", cls.__qualname__ || cls.__name__);
    var names = Object.getOwnPropertyNames(proto);
    for (var i = 0; i < names.length; i++) {
        var k = names[i];
        if (k === "constructor" || k === "__bases__" || k === "__class__" || k === "__bind_methods__" || k.indexOf("ρσ") === 0) continue;
        var d = Object.getOwnPropertyDescriptor(proto, k);
        ns.jsmap.set(k, "value" in d ? d.value : proto[k]);
    }
    return ns;
}

function ρσ_metaclass_methods(cls, M) {
    var seen = Object.create(null);
    for (var p = M.prototype; p && p !== ρσ_type.prototype && p !== Object.prototype; p = Object.getPrototypeOf(p)) {
        var names = Object.getOwnPropertyNames(p);
        for (var i = 0; i < names.length; i++) {
            var k = names[i];
            if (seen[k] || k === "constructor" || k === "__init__" || k === "__bases__" || k === "__class__" || k === "__bind_methods__" || k.indexOf("ρσ") === 0) continue;
            seen[k] = true;
            var d = Object.getOwnPropertyDescriptor(p, k);
            if (d.get) {
                Object.defineProperty(cls, k, {get: d.get, set: d.set, configurable: true});
            } else if (typeof d.value === "function" && !(k in cls)) {
                Object.defineProperty(cls, k, {get: ρσ_bind_to_this(d.value), configurable: true});
            } else if (!(k in cls)) {
                ρσ_forward_meta_attr(cls, p, k);  // a metaclass attribute, read through the class
            }
        }
    }
}

function ρσ_forward_meta_attr(cls, proto, k) {
    Object.defineProperty(cls, k, {
        get: function () { return proto[k]; },
        set: function (v) { Object.defineProperty(this, k, {value: v, writable: true, enumerable: true, configurable: true}); },
        configurable: true
    });
}

function ρσ_bind_to_this(f) {
    return function () { return f.bind(this); };
}

function ρσ_apply_metaclass(cls, M) {
    if (typeof M !== "function") return;
    Object.defineProperty(cls, "ρσ_metaclass", {value: M, writable: true, configurable: true});
    if (M === ρσ_type) return;
    var bases = ρσ_tuple_decorate((cls.prototype.__bases__ || []).slice());
    var name = cls.__name__;
    if (!(M.prototype instanceof ρσ_type)) {
        M(name, bases, ρσ_class_namespace(cls));  // a plain callable used as the metaclass
        return;
    }
    ρσ_metaclass_methods(cls, M);
    if (typeof M.prototype.__call__ === "function" && M.prototype.__call__ !== ρσ_type.prototype.__call__) {
        Object.defineProperty(cls, "ρσ_mcall", {value: true, configurable: true});
    }
    if (typeof M.__new__ === "function" && M.__new__ !== ρσ_type.__new__) {
        var ns = ρσ_class_namespace(cls), saved = ρσ_pending_class;
        ρσ_pending_class = cls;
        try {
            M.__new__(M, name, bases, ns);
        } finally {
            ρσ_pending_class = saved;
        }
        // changes the metaclass made to the namespace apply to the class
        ns.jsmap.forEach(function (val, key) {
            if (typeof key === "string" && key !== "__module__" && key !== "__qualname__" && cls.prototype[key] !== val) cls.prototype[key] = val;
        });
    }
    var init = M.prototype.__init__;
    if (typeof init === "function" && init !== ρσ_type.prototype.__init__) init.call(cls, name, bases, ρσ_class_namespace(cls));
}

// type(name, bases, dict): create a class at runtime
function ρσ_make_class(name, bases, ns) {
    bases = bases ? Array.prototype.slice.call(bases) : [];
    var parent = bases.length ? bases[0] : null;
    var C = function () {
        if (C.ρσ_mcall && ρσ_meta_enter(C, this)) return ρσ_meta_call(C, arguments);
        if (!(this instanceof C)) return new C(...arguments);
        if (this.ρσ_object_id === undefined) Object.defineProperty(this, "ρσ_object_id", {"value": ++ρσ_object_counter});
        if (typeof this.__init__ === "function") this.__init__.apply(this, arguments);
    };
    if (parent) ρσ_extends(C, parent);
    Object.defineProperty(C, "name", {value: name, configurable: true});
    var entries = [];
    if (ns && ns.jsmap) ns.jsmap.forEach(function (v, k) { entries.push([k, v]); });
    else if (ns) Object.keys(ns).forEach(function (k) { entries.push([k, ns[k]]); });
    for (var i = 0; i < entries.length; i++) {
        var k = entries[i][0], v = entries[i][1];
        if (k === "__module__" || k === "__qualname__") continue;
