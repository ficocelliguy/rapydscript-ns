# ── Annotations: generic aliases (list[int]), X | Y unions, and type_enforcement ──

def ρσ_annotation_repr(a):
    if a is None:
        return 'None'
    if jstype(a) is 'function':
        return a.__name__ or a.name
    return ρσ_str(a)

def ρσ_generic_alias(origin, args):
    # What list[int], dict[str, int], tuple[int, ...] evaluate to: enough for
    # isinstance-style checks (against the origin) and a readable repr.
    args = args if Array.isArray(args) and not args.ρσ_is_tuple else [args]
    alias = v'{__origin__: origin, __args__: args, _name: ""}'
    alias.toString = alias.__repr__ = alias.__str__ = def():
        return ρσ_annotation_repr(origin) + '[' + [ρσ_annotation_repr(x) for x in args].join(', ') + ']'
    return alias

def ρσ_is_annotation_like(x):
    if x is None or jstype(x) is 'function':
        return True
    return jstype(x) is 'object' and (Array.isArray(x.__args__) or bool(x.__origin__))

def ρσ_union_alias(a, b):
    args = []
    for x in [a, b]:
        if x is not None and x._name is 'Union' and Array.isArray(x.__args__):
            args = args.concat(x.__args__)
        elif args.indexOf(x) is -1:
            args.push(x)
    alias = v'{__args__: args, _name: "Union"}'
    alias.toString = alias.__repr__ = alias.__str__ = def():
        return [ρσ_annotation_repr(x) for x in args].join(' | ')
    alias.__or__ = def(other): return ρσ_union_alias(alias, other);
    return alias

def ρσ_type_check(obj, q):
    # Whether a value satisfies a parameter annotation, for type_enforcement.
    # Looser than isinstance() where Python's type system is: int is accepted
    # for float/complex and bool for int (PEP 484's numeric tower), and
    # annotations with no runtime meaning (string forward references,
    # TypeVars, ...) accept anything.
    if q is None:
        return obj is None
    if jstype(q) is not 'function' and not (jstype(q) is 'object' and (Array.isArray(q.__args__) or q.__origin__ or q.__is_typing_any__)):
        return True
    if Array.isArray(q.__args__) and (q._name is 'Union' or q._name is 'Optional'):
        for a in q.__args__:
            if ρσ_type_check(obj, a):
                return True
        return False
    if q is ρσ_float:
        return jstype(obj) is 'number' or jstype(obj) is 'boolean'
    if q is ρσ_complex:
        return jstype(obj) is 'number' or jstype(obj) is 'boolean' or ρσ_instanceof(obj, q)
    if q is ρσ_int and jstype(obj) is 'boolean':
        return True
    return ρσ_instanceof(obj, q)

# ── Python generator methods ──
v'''function ρσ_generator_exception(typ, val) {
    // g.throw(ValueError) / g.throw(ValueError("x")) / g.throw(ValueError, "x")
    if (typeof typ === "function") return (val instanceof typ) ? val : (val !== undefined ? new typ(val) : new typ());
    return typ;
}
function ρσ_stop_iteration(value, cls) {
    var e = new (cls || StopIteration)();
    e.value = value === undefined ? null : value;  // a generator's return value
    return e;
}
function ρσ_generator_methods(gen) {
    // send() / throw() return the next yielded value (raising StopIteration when
    // the generator finishes), as in Python; next() keeps the JS iterator protocol.
    var js_next = gen.next, js_throw = gen["throw"], js_return = gen["return"];
    gen.ρσ_js_throw = js_throw;  // the iterator-protocol throw(), for runtime code such as contextlib
    function unwrap(r) { if (r.done) throw ρσ_stop_iteration(r.value); return r.value; }
    gen.send = function (value) { return unwrap(js_next.call(gen, value)); };
    gen["throw"] = function (typ, val) { return unwrap(js_throw.call(gen, ρσ_generator_exception(typ, val))); };
    gen.close = function () { js_return.call(gen); return null; };
    return gen;
}
function ρσ_async_generator_methods(gen) {
    var js_next = gen.next, js_throw = gen["throw"], js_return = gen["return"];
    gen.ρσ_js_throw = js_throw;  // the iterator-protocol throw(), for runtime code such as contextlib
    function unwrap(r) { if (r.done) throw ρσ_stop_iteration(r.value, StopAsyncIteration); return r.value; }
    gen.send = js_next;  // (kept from earlier releases; Python async generators only have asend)
    gen.asend = function (value) { return js_next.call(gen, value).then(unwrap); };
    gen.athrow = function (typ, val) { return js_throw.call(gen, ρσ_generator_exception(typ, val)).then(unwrap); };
    gen.aclose = function () { return js_return.call(gen).then(function () { return null; }); };
    return gen;
}'''

# ── match / case pattern helpers ──
v'''var ρσ_match_self_types = null;
function ρσ_match_is_self_type(cls) {
    // Builtins whose single positional pattern captures the subject itself: case int(n)
    if (!ρσ_match_self_types) ρσ_match_self_types = [ρσ_int, ρσ_float, ρσ_str, ρσ_bool, ρσ_list_constructor,
        ρσ_tuple_constructor, ρσ_dict, ρσ_set, ρσ_frozenset, ρσ_bytes, ρσ_bytearray];
    return ρσ_match_self_types.indexOf(cls) >= 0;
}
function ρσ_match_class(subj, cls) {
    if (typeof cls !== "function") throw new TypeError("called match pattern must be a class");
    return ρσ_instanceof(subj, cls);
}
function ρσ_match_pos(subj, cls, i) {
