def ρσ_instanceof():
    obj = arguments[0]
    bases = ''
    if obj and obj.constructor and obj.constructor.prototype:
        bases = obj.constructor.prototype.__bases__ or ''
    for v'var i = 1; i < arguments.length; i++':
        q = arguments[i]
        # ── typing.Any (special form) — matches every value ────────────────
        if q and q.__is_typing_any__ is True:
            return True
        # ── A class-level __instancecheck__ (ABCs such as numbers.Number,
        # collections.abc.Iterable) decides for itself ─────────────────────
        if q and jstype(q.__instancecheck__) is 'function':
            if q.__instancecheck__(obj):
                return True
            continue
        # ── Parameterised typing generic (Optional[…], List[…], Union[…], …) ──
        # Detected by duck-typing on the _GenericAlias contract: a non-class
        # object that exposes an `__args__` Array.
        if q and Array.isArray(q.__args__):
            args = q.__args__
            name = q._name or ''
            if name is 'Union' or name is 'Optional':
                for v'var j = 0; j < args.length; j++':
                    a = args[j]
                    if a is None:
                        if obj is None:
                            return True
                    elif ρσ_instanceof(obj, a):
                        return True
                continue
            if name is 'Literal':
                for v'var j = 0; j < args.length; j++':
                    if obj is args[j]:
                        return True
                continue
            if name is 'ClassVar' or name is 'Final':
                if args.length > 0:
                    a = args[0]
                    if a is None:
                        if obj is None:
                            return True
                    elif ρσ_instanceof(obj, a):
                        return True
                continue
            if name is 'Callable':
                if jstype(obj) is 'function':
                    return True
                continue
            if name is 'Type':
                for v'var j = 0; j < args.length; j++':
                    if obj is args[j]:
                        return True
                continue
            if q.__origin__:
                if ρσ_instanceof(obj, q.__origin__):
                    return True
                continue
            # Abstract typing forms with no concrete origin (Iterator,
            # Iterable, Sequence, Mapping, IO, Pattern, Match, …) accept any
            # value — there is no runtime predicate to apply.
            return True
        if v'obj instanceof q':
            return True
        if jstype(obj) is 'function' and (q is ρσ_type or (obj.ρσ_metaclass and (obj.ρσ_metaclass is q or v'obj.ρσ_metaclass.prototype instanceof q'))):
            return True  # a class is an instance of type (and of its metaclass)
        if (q is Array or q is ρσ_list_constructor) and Array.isArray(obj) and obj.ρσ_is_tuple is not True:
            return True
        if q is ρσ_tuple_constructor and Array.isArray(obj) and obj.ρσ_is_tuple is True:
            return True
        if q is ρσ_str and (jstype(obj) is 'string' or v'obj instanceof String'):
            return True
        if q is ρσ_bool and (jstype(obj) is 'boolean' or v'obj instanceof Boolean'):
            return True
        if q is ρσ_int and ((jstype(obj) is 'number' and Number.isInteger(obj)) or jstype(obj) is 'boolean'):
            return True  # (bool is a subclass of int)
        if q is ρσ_object and obj is not undefined:
            return True  # everything is an object
        if q is ρσ_float and (jstype(obj) is 'number' and not Number.isInteger(obj)):
            return True
        if q is ρσ_long and jstype(obj) is 'bigint':
            return True
        if bases.length > 1:
            for v'var c = 1; c < bases.length; c++':
                cls = bases[c]
                while cls:
                    if q is cls:
                        return True
                    p = Object.getPrototypeOf(cls.prototype)
                    if not p:
                        break
                    cls = p.constructor
