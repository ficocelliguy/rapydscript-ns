        result = v'[]'
        for v'var ρσ_mi = 0; ρσ_mi < b; ρσ_mi++':
            result = result.concat(a)  # noqa:undef
        return ρσ_tuple_constructor(result) if a.ρσ_is_tuple else ρσ_list_constructor(result)
    if Array.isArray(b) and (ta is 'number' or ta is 'boolean'):
        result = v'[]'
        for v'var ρσ_mi = 0; ρσ_mi < a; ρσ_mi++':
            result = result.concat(b)  # noqa:undef
        return ρσ_tuple_constructor(result) if b.ρσ_is_tuple else ρσ_list_constructor(result)
