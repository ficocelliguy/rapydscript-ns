    // (looked up on the class or its prototype), or the subject itself for builtins
    var args = (typeof cls === "function" && cls.__match_args__) || (cls && cls.prototype && cls.prototype.__match_args__);
    if (args && i < args.length) return subj[args[i]];
    if (i === 0 && ρσ_match_is_self_type(cls)) return subj;
    throw new TypeError((cls && (cls.__name__ || cls.name)) + "() accepts " + (args ? args.length : 0) + " positional sub-pattern" + (args && args.length === 1 ? "" : "s") + " (" + (i + 1) + " given)");
}
function ρσ_match_mapping(subj) {
    if (subj === null || subj === undefined || typeof subj !== "object" || Array.isArray(subj)) return false;
    if (subj instanceof ρσ_dict || (typeof Map === "function" && subj instanceof Map)) return true;
    var proto = Object.getPrototypeOf(subj);
    return proto === Object.prototype || proto === null;  // a plain JS object used as a mapping
}
function ρσ_match_has(subj, key) {
