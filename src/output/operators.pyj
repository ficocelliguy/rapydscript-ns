from __python__ import hash_literals
from ast import (
    AST_Array, AST_Assign, AST_BaseCall, AST_Binary, AST_Conditional,
    AST_ItemAccess, AST_NamedExpr, AST_Dot, AST_Number, AST_Object, AST_Return, AST_Seq, AST_Set,
    AST_SimpleStatement, AST_Statement, AST_String, AST_Constant, AST_Sub, AST_Symbol,
    AST_SymbolRef, AST_Starred, AST_Spread, AST_True, AST_False, AST_Unary, AST_AnnotatedAssign, is_node_type
)
from output.loops import unpack_tuple


def print_getattr(self, output, skip_expression):  # AST_Dot
    if not skip_expression:
        expr = self.expression
        # Redirect JSON.parse → ρσ_json_parse so RapydScript code gets dict-aware
        # parsing without polluting the global JSON.parse for other JS on the page.
        if is_node_type(expr, AST_SymbolRef) and expr.name == 'JSON' and self.property == 'parse':
            output.print('ρσ_json_parse')
            return
        if self.bind_value:
            # lst.append as a value keeps its receiver (ρσ_attr_bind)
            output.print('ρσ_attr_bind('), expr.print(output), output.print(', ' + JSON.stringify(self.property) + ')')
            return
        if self.property is '__dict__':
            # obj.__dict__: a dict of the instance attributes that writes through
            output.print('ρσ_vars('), expr.print(output), output.print(', true)')
            return
        expr.print(output)
    if is_node_type(expr, AST_Number) and expr.value >= 0:
        if not /[xa-f.]/i.test(output.last()):
            output.print(".")
    output.print(".")
    # the name after dot would be mapped about here.
    output.print_property(self.property)

def print_getitem(self, output):  # AST_Sub
    expr = self.expression
    prop = self.property
    # Tuple-style subscript: a[1, 2] → a[[1, 2]]
    if is_node_type(prop, AST_Array) and prop.is_subscript_tuple:
        expr.print(output)
        output.print('[[')
        for i, elem in enumerate(prop.elements):
            if i:
                output.comma()
            elem.print(output)
        output.print(']]')
        return
    if (is_node_type(prop, AST_Number) or is_node_type(prop, AST_String)) or (is_node_type(prop, AST_SymbolRef) and prop.name and prop.name.startsWith('ρσ_')):
        expr.print(output)
        output.print('['), prop.print(output), output.print(']')
        return
    is_negative_number = is_node_type(prop, AST_Unary) and prop.operator is "-" and is_node_type(prop.expression, AST_Number) and not prop.overloaded
    is_repeatable = is_node_type(expr, AST_SymbolRef)
    if is_repeatable:
        expr.print(output)
    else:
        output.spaced('(ρσ_expr_temp', '=', expr), output.print(')')
        expr = {'print': def(): output.print('ρσ_expr_temp');}

    if is_negative_number:
        output.print('['), expr.print(output), output.print('.length'), prop.print(output), output.print(']')
        return
    is_repeatable = is_node_type(prop, AST_SymbolRef)
    # We have to check the type of the property because if it is a Symbol, it
    # will raise a TypeError with the < operator.
    if is_repeatable:
        output.spaced('[(typeof', prop, '===', '"number"', '&&', prop)
        output.spaced('', '<', '0)', '?', expr), output.spaced('.length', '+', prop, ':', prop)
        output.print("]")
    else:
        output.print('[ρσ_bound_index('), prop.print(output), output.comma(), expr.print(output), output.print(')]')


def print_rich_getitem(self, output):  # AST_ItemAccess
    func = 'ρσ_' + ('setitem' if self.assignment else 'getitem')
    output.print(func + '(')
    self.expression.print(output), output.comma(), self.property.print(output)
    if self.assignment:
        output.comma()
        asg = self.assignment
        as_op = self.assign_operator
        if as_op.length > 0:
            self.assignment = None
            print_rich_getitem(self, output)
            self.assignment = asg
            output.space()
            output.print(as_op)
            output.space()
        self.assignment.print(output)
    output.print(')')

def print_splice_assignment(self, output):  # AST_Splice
    if self.step:
        # extended slice assignment: a[start:stop:step] = values
        output.print('ρσ_eslice_assign(')
        self.expression.print(output), output.comma(), self.assignment.print(output)
        for bound in [self.property, self.property2, self.step]:
            output.comma()
            if bound:
                bound.print(output)
            else:
                output.print('undefined')
        output.print(')')
        return
    # splice assignment via pythonic array[start:end]
    output.print('ρσ_splice(')
    self.expression.print(output), output.comma(), self.assignment.print(output), output.comma()
    self.property.print(output) if self.property else output.print('0')
    if self.property2:
        output.comma()
        self.property2.print(output)
    output.print(')')

def print_delete(self, output):
    if is_node_type(self, AST_Symbol):
        # the name becomes unbound: later reads raise NameError (ρσ_check_bound)
        output.print_name(self.name), output.space(), output.print('='), output.space(), output.print('ρσ_del_name('), output.print_name(self.name), output.print(', ' + JSON.stringify(self.name) + ', ' + JSON.stringify(self.unbound_check or 'del_global') + ')')
    elif is_node_type(self, AST_Sub) or is_node_type(self, AST_ItemAccess):
        output.print('ρσ_delitem('), self.expression.print(output), output.comma(), self.property.print(output), output.print(')')
    elif is_node_type(self, AST_Dot):
        output.print('ρσ_delattr('), self.expression.print(output), output.comma(), output.print(JSON.stringify(self.property) + ')')
    else:
        output.spaced('delete', self)

def print_unary_prefix(self, output):
    op = self.operator
    if op is 'delete':
        return print_delete(self.expression, output)
    if self.overloaded:
        if op is '-':
            output.print('ρσ_op_neg('), self.expression.print(output), output.print(')')
            return
        if op is '+':
            output.print('ρσ_op_pos('), self.expression.print(output), output.print(')')
            return
        if op is '~':
            output.print('ρσ_op_invert('), self.expression.print(output), output.print(')')
            return
    if op is '!' and self.python_truthiness:
        output.print('!ρσ_bool(')
        if self.parenthesized:
            output.with_parens(def():
                self.expression.print(output)
            )
        else:
            self.expression.print(output)
        output.print(')')
        return
    output.print(op)
    if /^[a-z]/i.test(op):
        output.space()
    if self.parenthesized:
        output.with_parens(def():
            self.expression.print(output)
        )
    else:
        self.expression.print(output)

def write_instanceof(left, right, output):

    def do_many(vals):
        output.print('ρσ_instanceof.apply(null,'), output.space()
        output.print('['), left.print(output), output.comma()
        for v'var i = 0; i < vals.length; i++':
            vals[i].print(output)
            if i is not vals.length - 1:
                output.comma()
        output.print('])')

    if is_node_type(right, AST_Seq):
        do_many(right.to_array())
    elif is_node_type(right, AST_Array):
        do_many(right.elements)
    else:
        output.print('ρσ_instanceof(')
        left.print(output), output.comma(), right.print(output), output.print(')')

def write_smart_equality(self, output):
    def is_ok(x):
        # The inline form below evaluates each operand twice, so only operands
        # that are safe to repeat qualify: names, literals and attribute chains
        # on them. Anything else (calls, subscripts, (x := f()), await, ...)
        # goes through ρσ_equals(), which evaluates it once.
        while is_node_type(x, AST_Dot):
            x = x.expression
        return is_node_type(x, AST_Symbol) or is_node_type(x, AST_Constant)
    # x == True: bool is an int in Python (True == 1), which only ρσ_equals knows
    bool_literal = is_node_type(self.left, AST_True) or is_node_type(self.left, AST_False) or is_node_type(self.right, AST_True) or is_node_type(self.right, AST_False)
    if is_ok(self.left) and is_ok(self.right) and not bool_literal:
        if self.operator is '==':
            output.print('(')
            output.spaced(self.left, '===', self.right, '||', 'typeof', self.left, '===', '"object"', '&&', 'ρσ_equals(')
            self.left.print(output), output.print(','), output.space(), self.right.print(output), output.print('))')
        else:
            output.print('(')
            output.spaced(self.left, '!==', self.right, '&&', '(typeof', self.left, '!==', '"object"', '||', 'ρσ_not_equals(')
            self.left.print(output), output.print(','), output.space(), self.right.print(output), output.print(')))')
    else:
        output.print('ρσ_' + ('equals(' if self.operator is '==' else 'not_equals('))
        self.left.print(output), output.print(','), output.space(), self.right.print(output), output.print(')')


function_ops = {
    "in": "ρσ_in",
    'nin': '!ρσ_in',
}

# Maps binary operators to their overloading helper function names (strict_arithmetic on).
overloaded_binary_ops = {
    '+':  'ρσ_op_add',
    '-':  'ρσ_op_sub',
    '*':  'ρσ_op_mul',
    '/':  'ρσ_op_truediv',
    '//': 'ρσ_op_floordiv',
    '%':  'ρσ_op_mod',
    '**': 'ρσ_op_pow',
    '&':  'ρσ_op_and',
    '|':  'ρσ_op_or',
    '^':  'ρσ_op_xor',
    '<<': 'ρσ_op_lshift',
    '>>': 'ρσ_op_rshift',
    '<':  'ρσ_op_lt',
    '>':  'ρσ_op_gt',
    '<=': 'ρσ_op_le',
    '>=': 'ρσ_op_ge',
}

# Maps binary operators to no-strict helpers (overload_operators on, strict_arithmetic off).
# Operators that never threw TypeError reuse the same helper; others use _ns variants.
overloaded_binary_ops_ns = {
    '+':  'ρσ_op_add_ns',
    '-':  'ρσ_op_sub_ns',
    '*':  'ρσ_op_mul_ns',
    '/':  'ρσ_op_truediv_ns',
    '//': 'ρσ_op_floordiv_ns',
    '%':  'ρσ_op_mod_ns',
    '**': 'ρσ_op_pow_ns',
    '&':  'ρσ_op_and',
    '|':  'ρσ_op_or',
    '^':  'ρσ_op_xor',
    '<<': 'ρσ_op_lshift',
    '>>': 'ρσ_op_rshift',
    '<':  'ρσ_op_lt_ns',
    '>':  'ρσ_op_gt_ns',
    '<=': 'ρσ_op_le_ns',
    '>=': 'ρσ_op_ge_ns',
}

# Maps augmented-assignment operators to their overloading helper names (strict_arithmetic on).
overloaded_augmented_ops = {
    '+=':  'ρσ_op_iadd',
    '-=':  'ρσ_op_isub',
    '*=':  'ρσ_op_imul',
    '/=':  'ρσ_op_itruediv',
    '//=': 'ρσ_op_ifloordiv',
    '%=':  'ρσ_op_imod',
    '**=': 'ρσ_op_ipow',
    '&=':  'ρσ_op_iand',
    '|=':  'ρσ_op_ior',
    '^=':  'ρσ_op_ixor',
    '<<=': 'ρσ_op_ilshift',
    '>>=': 'ρσ_op_irshift',
}

# Maps augmented-assignment operators to no-strict helpers (strict_arithmetic off).
overloaded_augmented_ops_ns = {
    '+=':  'ρσ_op_iadd_ns',
    '-=':  'ρσ_op_isub_ns',
    '*=':  'ρσ_op_imul_ns',
    '/=':  'ρσ_op_itruediv_ns',
    '//=': 'ρσ_op_ifloordiv_ns',
    '%=':  'ρσ_op_imod_ns',
    '**=': 'ρσ_op_ipow_ns',
    '&=':  'ρσ_op_iand',
    '|=':  'ρσ_op_ior',
    '^=':  'ρσ_op_ixor',
    '<<=': 'ρσ_op_ilshift',
    '>>=': 'ρσ_op_irshift',
}


def print_comparison_chain(self, output):
    # a < b == c (self.chained, self.left the earlier comparisons) becomes
    # (a < (t = b) && t == c): each link is printed as an ordinary comparison,
    # so ==, in, is and operator overloading behave as they do unchained, and
    # a middle operand that isn't a plain name or literal is evaluated once.
    links = []
    node = self
    while node.chained:
        links.unshift(node)
        node = node.left
    links.unshift(node)
    output.print('(')
    prev = links[0].left
    for i, link in enumerate(links):
        right = link.right
        rhs = right
        if i < links.length - 1 and not (is_node_type(right, AST_Symbol) or is_node_type(right, AST_Constant)):
            temp = new AST_SymbolRef({'name': 'ρσ_cond_temp', 'start': right.start, 'end': right.end})
            rhs = new AST_Assign({'operator': '=', 'left': temp, 'right': right, 'start': right.start, 'end': right.end})
            # A middle operand that is itself an assignment, 1 < (x += 1) < 5,
            # must not be folded into a chained `temp = x = ...` assignment.
            rhs.is_chained = def(): return False;
            right = temp
        if i:
            output.space(), output.print('&&'), output.space()
        new AST_Binary({
            'operator': link.operator, 'left': prev, 'right': rhs,
            'overloaded': link.overloaded, 'strict_arith': link.strict_arith,
            'python_mod': link.python_mod, 'python_div': link.python_div,
            'python_truthiness': link.python_truthiness,
            'start': link.start, 'end': link.end,
        }).print(output)
        prev = right
    output.print(')')


def print_binary_op(self, output):
    if self.chained:
        print_comparison_chain(self, output)
        return
    ops_map = overloaded_binary_ops if self.strict_arith else overloaded_binary_ops_ns
    if self.overloaded and ops_map[self.operator]:
        output.print(ops_map[self.operator] + '(')
        self.left.print(output)
        output.comma()
        self.right.print(output)
        output.print(')')
        return
    if self.operator is '%' and self.python_mod:
        output.print('ρσ_op_mod_ns(')
        self.left.print(output)
        output.comma()
        self.right.print(output)
        output.print(')')
        return
    if self.operator is '/' and self.python_div:
        output.print('ρσ_op_truediv_ns(')
        self.left.print(output)
        output.comma()
        self.right.print(output)
        output.print(')')
        return
    if self.operator is '//' and self.python_div:
        output.print('ρσ_op_floordiv_ns(')
        self.left.print(output)
        output.comma()
        self.right.print(output)
        output.print(')')
        return
    if function_ops[self.operator]:
        output.print(function_ops[self.operator])
        output.with_parens(def():
            self.left.print(output)
            output.comma()
            self.right.print(output)
        )
    elif self.operator is '//':
        output.print('Math.floor')
        output.with_parens(def():
            self.left.print(output)
            output.space()
            output.print('/')
            output.space()
            self.right.print(output)
        )
    elif self.operator is '**':
        left = self.left
        if is_node_type(self.left, AST_Unary) and not self.left.parenthesized:
            left = self.left.expression
            output.print(self.left.operator)
        if output.options.js_version > 6:
            output.print('(('), left.print(output), output.spaced(')', '**', '('), self.right.print(output), output.print('))')
        else:
            output.print('Math.pow('), left.print(output), output.comma(), self.right.print(output), output.print(')')
    elif self.operator is '==' or self.operator is '!=':
        write_smart_equality(self, output)
    elif self.operator is 'instanceof':
        write_instanceof(self.left, self.right, output)
    elif self.operator is '+':
        output.print('ρσ_list_add(')
        self.left.print(output)
        output.comma()
        self.right.print(output)
        output.print(')')
    elif self.operator is '*' and is_node_type(self.left, AST_String):
        # Python-style string repetition: clamp negative counts to 0 (Python returns '' for negatives;
        # JS String.prototype.repeat throws RangeError).
        self.left.print(output), output.print('.repeat(Math.max(0,'), self.right.print(output), output.print('))')
    elif self.operator is '*' and is_node_type(self.right, AST_String):
        self.right.print(output), output.print('.repeat(Math.max(0,'), self.left.print(output), output.print('))')
    elif self.operator is '===' or self.operator is '!==':
        nan_check = None
        if is_node_type(self.right, AST_Symbol) and self.right.name is 'NaN':
            nan_check = self.left
        if is_node_type(self.left, AST_Symbol) and self.left.name is 'NaN':
            nan_check = self.right
        if nan_check is not None:
            # We use the fact that NaN is the only object that is not equal to
            # itself
            output.spaced(nan_check, '!==' if self.operator is '===' else '===', nan_check)
        else:
            output.spaced(self.left, self.operator, self.right)
    elif (self.operator is '&&' or self.operator is '||') and self.python_truthiness:
        # Python `and`/`or` use Python truthiness (only when from __python__ import truthiness is set).
        # `a and b` → `ρσ_bool(a) ? b : a`   (returns a if falsy, else b)
        # `a or b`  → `ρσ_bool(a) ? a : b`   (returns a if truthy, else b)
        # For non-simple left operands, cache in ρσ_expr_temp to avoid double evaluation.
        is_and = self.operator is '&&'
        if is_node_type(self.left, AST_SymbolRef):
            output.print('(ρσ_bool(')
            self.left.print(output)
            output.print(') ? ')
            if is_and:
                self.right.print(output)
                output.print(' : ')
                self.left.print(output)
            else:
                self.left.print(output)
                output.print(' : ')
                self.right.print(output)
            output.print(')')
        else:
            output.print('(ρσ_expr_temp = ')
            self.left.print(output)
            output.print(', ρσ_bool(ρσ_expr_temp) ? ')
            if is_and:
                self.right.print(output)
                output.print(' : ρσ_expr_temp)')
            else:
                output.print('ρσ_expr_temp : ')
                self.right.print(output)
                output.print(')')
    else:
        output.spaced(self.left, self.operator, self.right)

after_map = {'.':'d', '(':'c', '[':'d', 'g':'g', 'null':'n'}

def print_existential(self, output):
    key = after_map[self.after] if self.after is None or jstype(self.after) is 'string' else 'e'
    if is_node_type(self.expression, AST_SymbolRef):
        if key is 'n':
            output.spaced('(typeof', self.expression, '!==', '"undefined"', '&&', self.expression, '!==', 'null)')
            return
        if key is 'c':
            output.spaced('(typeof', self.expression, '===', '"function"', '?', self.expression, ':', '(function(){return undefined;}))')
            return
        after = self.after
        if key is 'd':
            after = 'Object.create(null)'
        elif key is 'g':
            after = '{__getitem__:function(){return undefined;}}'
        output.spaced('(typeof', self.expression, '!==', '"undefined"', '&&', self.expression, '!==', 'null', '?', self.expression, ':', after)
        output.print(')')
        return
    output.print('ρσ_exists.' + key + '(')
    self.expression.print(output)
    if key is 'e':
        output.comma(), self.after.print(output)
    output.print(')')

def print_assignment(self, output):
    flattened = False
    left = self.left
    if is_node_type(left, AST_Seq):
        left = new AST_Array({'elements':v'[left.car, left.cdr]'})
    if is_node_type(left, AST_Array):
        flat = left.flatten()
        flattened = flat.length > left.elements.length
        has_starred = False
        for elem in flat:
            if is_node_type(elem, AST_Starred):
                has_starred = True
                break
        output.print("ρσ_unpack")
    else:
        left.print(output)
    output.space()
    output.print(self.operator)
    output.space()
    if flattened:
        output.print('ρσ_flatten')
        output.with_parens(def():self.right.print(output);)
    else:
        self.right.print(output)
    if is_node_type(left, AST_Array):
        output.end_statement()
        literal_count = -1  # elements in a literal right-hand side, when knowable
        if not flattened and not has_starred:
            if is_node_type(self.right, AST_Seq):
                literal_count = self.right.to_array().length
            elif is_node_type(self.right, AST_Array):
                literal_count = self.right.elements.length
                for elem in self.right.elements:
                    if is_node_type(elem, AST_Spread):
                        literal_count = -1
                        break
        # a, b = 1, 2 needs no runtime check; a, b = 1, 2, 3 (or [*xs]) does
        needs_check = literal_count is not flat.length
        if is_node_type(self.right, AST_Seq) or is_node_type(self.right, AST_Array):
            needs_check = needs_check and not flattened and not has_starred
        if needs_check:
            output.assign('ρσ_unpack')
            if has_starred:
                output.print('ρσ_unpack_starred_asarray('), output.print('ρσ_unpack)')
            else:
                output.print('ρσ_unpack_asarray(' + flat.length), output.comma(), output.print('ρσ_unpack)')
            output.end_statement()
        unpack_tuple(flat, output, True)

def print_assign(self, output):
    if self.overloaded and overloaded_augmented_ops[self.operator]:
        aug_map = overloaded_augmented_ops if self.strict_arith else overloaded_augmented_ops_ns
        helper = aug_map[self.operator]
        output.assign(self.left)
        output.print(helper + '(')
        self.left.print(output)
        output.comma()
        self.right.print(output)
        output.print(')')
        return
    if self.operator is '//=':
        output.assign(self.left)
        if self.python_div:
            output.print('ρσ_op_floordiv_ns(')
            self.left.print(output)
            output.comma()
            self.right.print(output)
            output.print(')')
        else:
            output.print('Math.floor')
            output.with_parens(def():
                self.left.print(output)
                output.space()
                output.print('/')
                output.space()
                self.right.print(output)
            )
        return
    if self.operator is '/=' and self.python_div:
        output.assign(self.left)
        output.print('ρσ_op_truediv_ns(')
        self.left.print(output)
        output.comma()
        self.right.print(output)
        output.print(')')
        return
    if self.operator is '%=' and self.python_mod:
        output.assign(self.left)
        output.print('ρσ_op_mod_ns(')
        self.left.print(output)
        output.comma()
        self.right.print(output)
        output.print(')')
        return
    if self.operator is '**=':
        output.assign(self.left)
        if output.options.js_version > 6:
            output.print('(('), self.left.print(output), output.spaced(')', '**', '('), self.right.print(output), output.print('))')
        else:
            output.print('Math.pow('), self.left.print(output), output.comma(), self.right.print(output), output.print(')')
        return
    if self.operator is '+=':
        output.assign(self.left)
        output.print('ρσ_list_iadd(')
        self.left.print(output)
        output.comma()
        self.right.print(output)
        output.print(')')
        return
    if self.operator is '=' and self.is_chained():
        left_hand_sides, rhs = self.traverse_chain()
        is_compound_assign = False
        for lhs in left_hand_sides:
            if is_node_type(lhs, AST_Seq) or is_node_type(lhs, AST_Array) or is_node_type(lhs, AST_ItemAccess):
                is_compound_assign = True
                break
        if is_compound_assign:
            temp_rhs = new AST_SymbolRef({'name':'ρσ_chain_assign_temp'})
            print_assignment(new AST_Assign({'left':temp_rhs, 'operator':'=', 'right':rhs}), output)
            for lhs in left_hand_sides:
                output.end_statement(), output.indent()
                print_assignment(new AST_Assign({'left':lhs, 'right':temp_rhs, 'operator':self.operator}), output)
        else:
            for lhs in left_hand_sides:
                output.spaced(lhs, '=', '')
            rhs.print(output)
    else:
        print_assignment(self, output)

def print_conditional(self, output, condition, consequent, alternative):
    condition, consequent, alternative = self.condition, self.consequent, self.alternative
    if self.python_truthiness:
        output.print('ρσ_bool(')
        condition.print(output)
        output.print(')')
    else:
        output.with_parens(def(): condition.print(output);)
    output.space()
    output.print("?")
    output.space()
    consequent.print(output)
    output.space()
    output.colon()
    alternative.print(output)

def print_seq(output):
    self = this
    p = output.parent()
    print_seq = def():
        self.car.print(output)
        if self.cdr:
            output.comma()
            if output.should_break():
                output.newline()
                output.indent()
            self.cdr.print(output)

    # this will effectively convert tuples to arrays
    if is_node_type(p, AST_Binary)
    or is_node_type(p, AST_Return)
    or is_node_type(p, AST_Array)
    or is_node_type(p, AST_BaseCall)
    or is_node_type(p, AST_SimpleStatement)
    or is_node_type(p, AST_AnnotatedAssign):
        output.with_square(print_seq)
    else:
        print_seq()

def print_named_expr(self, output):
    # Walrus operator: name := value  →  (name = value)
    output.with_parens(def():
        output.assign(self.name)
        self.value.print(output)
    )
