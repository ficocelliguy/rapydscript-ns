from __python__ import hash_literals

from ast import AST_ClassCall, AST_New, AST_Method, has_calls, refers_to, AST_Dot, AST_SymbolRef, AST_String, is_node_type
from output.stream import OutputStream
from parse import parse as ρσ_rs_parse
from output.statements import print_bracketed
from output.utils import create_doctring
from output.operators import print_getattr

anonfunc = 'ρσ_anonfunc'
module_name = 'null'

def set_module_name(x):
    nonlocal module_name
    module_name = '"' + x + '"' if x else 'null'


# Function definition {{{

def decorate(decorators, output, func):
    pos = 0
    def wrap():
        nonlocal pos
        if pos < decorators.length:
            decorators[pos].expression.print(output)
            pos += 1
            output.with_parens(def():
                wrap()
            )
        else:
            func()
    wrap()

def function_args(argnames, output, strip_first):
    output.with_parens(def():
        if argnames and argnames.length and (argnames.is_simple_func is True or argnames.is_simple_func is undefined):
            for i, arg in enumerate((argnames.slice(1) if strip_first else argnames)):
                if i:
                    output.comma()
                arg.print(output)
    )
    output.space()

def function_preamble(node, output, offset):
    a = node.argnames
    if a is None or a is undefined:
        return
    type_enforce = node.type_enforce
    if a.is_simple_func and not type_enforce:
        return
    # If this function has optional parameters/*args/**kwargs declare it differently
    fname = node.name.name if node.name else anonfunc
    # How the body refers to its own function object (for __defaults__): an
    # unnamed function expression has no own name binding, but ρσ_anonfunc.
    fref = anonfunc if node.emit_unnamed or not node.name else node.name.name
    kw = 'arguments[arguments.length-1]'

    # === Type enforcement: max positional-arg count check ===
    if type_enforce:
        max_pos = 0
        for c, arg in enumerate(a):
            if c >= offset and not arg.kwonly:
                max_pos += 1
        if a.is_simple_func:
            # Simple function: named JS params; arguments.length gives true count
            if not a.starargs:
                # Strip a trailing kwargs-marker object so a `*args, **kwargs`
                # caller does not get blamed for an extra positional argument
                # (matches the complex-func variant below).
                output.indent()
                output.spaced('var', 'ρσ_nargs', '=', 'arguments.length')
                output.end_statement()
                output.indent()
                output.print('if (ρσ_nargs > 0 && arguments[ρσ_nargs-1] !== null && typeof arguments[ρσ_nargs-1] === "object" && arguments[ρσ_nargs-1][ρσ_kwargs_symbol] === true) ρσ_nargs--')
                output.end_statement()
                max_msg = fname + '() takes ' + max_pos + ' positional argument' + ('' if max_pos == 1 else 's') + ' but '
                output.indent()
                output.print('if (ρσ_nargs > ' + max_pos + ') throw new TypeError(' + JSON.stringify(max_msg) + ' + ρσ_nargs + " were given")')
                output.end_statement()
            # Required-arg and type-annotation checks (variables are direct JS params)
            for c, arg in enumerate(a):
                if c < offset:
                    continue
                if not arg.kwonly:
                    miss_msg = fname + '() missing required positional argument: \'' + arg.name + '\''
                    output.indent()
                    output.print('if (' + output.make_name(arg.name) + ' === undefined) throw new TypeError(' + JSON.stringify(miss_msg) + ')')
                    output.end_statement()
                if arg.annotation:
                    annot_name = arg.annotation.name or ''
                    type_msg = fname + '() argument \'' + arg.name + '\' must be ' + annot_name
                    output.indent()
                    output.print('if (' + output.make_name(arg.name) + ' !== undefined && !ρσ_type_check(' + output.make_name(arg.name) + ', ')
                    arg.annotation.print(output)
                    output.print(')) throw new TypeError(' + JSON.stringify(type_msg) + ')')
                    output.end_statement()
            return  # simple func: only enforcement, no complex preamble

        # Complex function: must handle arguments object; strip trailing kwargs marker
        if not a.starargs:
            output.indent()
            output.spaced('var', 'ρσ_nargs', '=', 'arguments.length')
            output.end_statement()
            output.indent()
            output.print('if (ρσ_nargs > 0 && arguments[ρσ_nargs-1] !== null && typeof arguments[ρσ_nargs-1] === "object" && arguments[ρσ_nargs-1][ρσ_kwargs_symbol] === true) ρσ_nargs--')
            output.end_statement()
            max_msg = fname + '() takes ' + max_pos + ' positional argument' + ('' if max_pos == 1 else 's') + ' but '
            output.indent()
            output.print('if (ρσ_nargs > ' + max_pos + ') throw new TypeError(' + JSON.stringify(max_msg) + ' + ρσ_nargs + " were given")')
            output.end_statement()

    # Define all formal parameters
    positional_count = 0
    for c, arg in enumerate(a):
        i = c - offset
        if i >= 0:
            output.indent()
            output.print("var")
            output.space()
            output.assign(arg)
            if arg.kwonly:
                # Keyword-only params: initialize from defaults or undefined; read from kwargs later
                if Object.prototype.hasOwnProperty.call(a.defaults, arg.name):
                    output.print(fref + '.__defaults__.' + arg.name)
                else:
                    output.print('undefined')
            else:
                positional_count += 1
                if Object.prototype.hasOwnProperty.call(a.defaults, arg.name):
                    output.spaced('(arguments[' + i + ']', '===', 'undefined', '||',
                                    '(', i, '===', 'arguments.length-1', '&&', kw, '!==', 'null', '&&', 'typeof', kw, '===', '"object"', '&&',
                                    kw, '[ρσ_kwargs_symbol]', '===', 'true))', '?', '')
                    output.print(fref + '.__defaults__.' + arg.name)
                    output.space(), output.print(':'), output.space()
                    output.print('arguments[' + i + ']')
                else:
                    output.spaced('(', i, '===', 'arguments.length-1', '&&', kw, '!==', 'null', '&&', 'typeof', kw, '===', '"object"', '&&',
                                    kw, '[ρσ_kwargs_symbol]', '===', 'true)', '?', 'undefined', ':', '')
                    output.print('arguments[' + i + ']')
            output.end_statement()
    if a.kwargs or a.has_defaults or a.bare_star or a.kwonly_count:
        # Look for an options object
        kw = output.make_name(a.kwargs.name) if a.kwargs else 'ρσ_kwargs_obj'
        output.indent()
        output.spaced('var', kw, '=', 'arguments[arguments.length-1]')
        output.end_statement()
        # Ensure kwargs is the options object
        output.indent()
        output.spaced('if', '(' + kw, '===', 'null', '||', 'typeof', kw, '!==', '"object"', '||', kw, '[ρσ_kwargs_symbol]', '!==', 'true)', kw, '=', '{}')
        output.end_statement()
        # === Type enforcement: positional-only args must not appear in kwargs ===
        if type_enforce:
            posonly_count = a.posonly_count or 0
            for pi in range(posonly_count):
                if pi < offset:
                    continue
                parg = a[pi]
                posonly_msg = fname + '() got some positional-only arguments passed as keyword arguments: \'' + parg.name + '\''
                output.indent()
                output.spaced('if', '(Object.prototype.hasOwnProperty.call(' + kw + ',', '"' + parg.name + '"))')
                output.with_block(def():
                    output.indent()
                    output.print('throw new TypeError(' + JSON.stringify(posonly_msg) + ')')
                    output.end_statement()
                )
                output.newline()
        # Read values from the kwargs object for non-positional-only formal parameters with defaults
        if a.has_defaults:
            for dname in Object.keys(a.defaults):
                # Skip positional-only params: they must not be passed by keyword name
                is_posonly = False
                for v'var qi = 0; qi < (a.posonly_count || 0); qi++':
                    if a[qi].name is dname:
                        is_posonly = True
                        break
                if is_posonly:
                    continue
                # Skip kwonly params here; they are handled in the kwonly loop below
                is_kwonly = False
                for v'var ki = 0; ki < a.length; ki++':
                    if a[ki].name is dname and a[ki].kwonly:
                        is_kwonly = True
                        break
                if is_kwonly:
                    continue
                output.indent()
                output.spaced('if', '(Object.prototype.hasOwnProperty.call(' + kw + ',', '"' + dname + '"))')
                output.with_block(def():
                    output.indent()
                    output.spaced(output.make_name(dname), '=', kw + '.' + dname)
                    output.end_statement()
                    if a.kwargs:
                        output.indent()
                        output.spaced('delete', kw + '.' + dname)
                        output.end_statement()
                )
                output.newline()
        # Read keyword-only params from the kwargs object (with or without defaults)
        if a.bare_star or a.kwonly_count:
            for arg in a:
                if not arg.kwonly:
                    continue
                aname = arg.name
                output.indent()
                output.spaced('if', '(Object.prototype.hasOwnProperty.call(' + kw + ',', '"' + aname + '"))')
                output.with_block(def():
                    output.indent()
                    output.spaced(output.make_name(aname), '=', kw + '.' + aname)
                    output.end_statement()
                    if a.kwargs:
                        output.indent()
                        output.spaced('delete', kw + '.' + aname)
                        output.end_statement()
                )
                output.newline()
    elif type_enforce and (a.posonly_count or 0) > 0:
        # No kwargs block, but function has positional-only params.
        # A caller using foo(posonly_name=val) still passes a kwargs object as the
        # last argument; detect and reject it here.
        posonly_count = a.posonly_count or 0
        posonly_names = []
        for pi in range(posonly_count):
            if pi >= offset:
                posonly_names.push(a[pi].name)
        if posonly_names.length > 0:
            output.indent()
            output.spaced('var', 'ρσ_kw_chk', '=', 'arguments[arguments.length-1]')
            output.end_statement()
            output.indent()
            output.spaced('if', '(ρσ_kw_chk !== null && typeof ρσ_kw_chk === "object" && ρσ_kw_chk[ρσ_kwargs_symbol] === true)')
            output.with_block(def():
                for pname in posonly_names:
                    posonly_msg = fname + '() got some positional-only arguments passed as keyword arguments: \'' + pname + '\''
                    output.indent()
                    output.print('if (Object.prototype.hasOwnProperty.call(ρσ_kw_chk, "' + pname + '")) throw new TypeError(' + JSON.stringify(posonly_msg) + ')')
                    output.end_statement()
            )
            output.newline()

    if a.starargs is not undefined:
        # Define the *args parameter, putting in whatever is left after assigning the formal parameters and the options object
        # (keyword-only params, which follow *args, take no positional slot)
        nargs = 0
        for c, arg in enumerate(a):
            if c >= offset and not arg.kwonly:
                nargs += 1
        output.indent()
        # *args is a tuple, as in Python
        output.spaced('var', output.make_name(a.starargs.name), '=', 'ρσ_tuple_decorate(Array.prototype.slice.call(arguments,', nargs + '))')
        output.end_statement()
        # Remove the options object, if present
        output.indent()
        output.spaced('if', '(' + kw, '!==', 'null', '&&', 'typeof', kw, '===', '"object"', '&&', kw, '[ρσ_kwargs_symbol]', '===', 'true)', output.make_name(a.starargs.name))
        output.print('.pop()')
        output.end_statement()

    # Convert the plain JS kwargs object to a proper Python dict so that
    # kw.items(), kw.keys(), etc. work in the function body.
    # This must happen AFTER defaults/kwonly/starargs processing which rely on
    # plain property access (kw.name) and ρσ_kwargs_symbol checks.
    if a.kwargs:
        output.indent()
        output.spaced(kw, '=', 'ρσ_kwargs_to_dict(' + kw + ')')
        output.end_statement()

    # === Type enforcement: required-arg, required-kwonly, and type-annotation checks ===
    # These run after all variable resolution (kwargs reading, starargs setup, dict conversion)
    # so each variable holds its final value when checked.
    if type_enforce:
        # Required positional args (no default, not kwonly)
        for c, arg in enumerate(a):
            if c < offset:
                continue
            if arg.kwonly:
                continue
            if not Object.prototype.hasOwnProperty.call(a.defaults, arg.name):
                miss_msg = fname + '() missing required positional argument: \'' + arg.name + '\''
                output.indent()
                output.print('if (' + output.make_name(arg.name) + ' === undefined) throw new TypeError(' + JSON.stringify(miss_msg) + ')')
                output.end_statement()
        # Required keyword-only args (no default)
        for c, arg in enumerate(a):
            if not arg.kwonly:
                continue
            if not Object.prototype.hasOwnProperty.call(a.defaults, arg.name):
                miss_kw = fname + '() missing required keyword-only argument: \'' + arg.name + '\''
                output.indent()
                output.print('if (' + output.make_name(arg.name) + ' === undefined) throw new TypeError(' + JSON.stringify(miss_kw) + ')')
                output.end_statement()
        # Type annotation checks (skip *args and **kwargs)
        for c, arg in enumerate(a):
            if c < offset:
                continue
            if not arg.annotation:
                continue
            annot_name = arg.annotation.name or ''
            type_msg = fname + '() argument \'' + arg.name + '\' must be ' + annot_name
            output.indent()
            output.print('if (' + output.make_name(arg.name) + ' !== undefined && !ρσ_type_check(' + output.make_name(arg.name) + ', ')
            arg.annotation.print(output)
            output.print(')) throw new TypeError(' + JSON.stringify(type_msg) + ')')
            output.end_statement()

def has_annotations(self):
    if self.return_annotation:
        return True
    for arg in self.argnames:
        if arg.annotation:
            return True
    return False

def function_annotation(self, output, strip_first, name):
    fname = name or (output.make_name(self.name.name) if self.name else anonfunc)
    props = Object.create(None)

    # Create __annotations__
    if has_annotations(self):
        props.__annotations__ = def():
            output.print('{')
            if self.argnames and self.argnames.length:
                for i, arg in enumerate(self.argnames):
                    if arg.annotation:
                        arg.print(output)
                        output.print(':'), output.space()
                        arg.annotation.print(output)
                        if i < self.argnames.length - 1 or self.return_annotation:
                            output.comma()
            if self.return_annotation:
                output.print('return:'), output.space()
                self.return_annotation.print(output)
            output.print('}')

    # Create __defaults__
    defaults = self.argnames.defaults
    dkeys = Object.keys(self.argnames.defaults)
    if dkeys.length:
        props.__defaults__ = def():
            output.print('{')
            for i, k in enumerate(dkeys):
                output.print(k + ':'), defaults[k].print(output)
                if i is not dkeys.length - 1:
                    output.comma()
            output.print('}')

    # Create __handles_kwarg_interpolation__
    if not self.argnames.is_simple_func:
        props.__handles_kwarg_interpolation__ = def():
            output.print('true')

    # Create __argnames__
    # Positional-only params use null (prevents kwarg matching by name).
    # Keyword-only params are omitted (they stay in the kwargs object and
    # are read directly by the function preamble).
    argnames_entries = v'[]'
    for i, arg in enumerate(self.argnames):
        if strip_first and i is 0:
            continue
        if arg.kwonly:
            continue  # kwonly params not in __argnames__
        argnames_entries.push({'posonly': arg.posonly or False, 'name': arg.name})
    if argnames_entries.length > 0:
        props.__argnames__ = def():
            output.print('[')
            for ei, entry in enumerate(argnames_entries):
                if entry.posonly:
                    output.print('null')
                else:
                    output.print(JSON.stringify(entry.name))
                if ei is not argnames_entries.length - 1:
                    output.comma()
            output.print(']')

    # Create __doc__
    if output.options.keep_docstrings and self.docstrings and self.docstrings.length:
        props.__doc__ = def():
            output.print(JSON.stringify(create_doctring(self.docstrings)))

    props.__module__ = def():
        output.print(module_name)

    # __name__ (writable, as functools.wraps assigns it)
    pyname = self.name.name if self.name and self.name.name else '<lambda>'
    props.__name__ = def():
        output.print(JSON.stringify(pyname) + ', writable: true, configurable: true')

    # Methods take self as `this`; property() and friends check this marker
    if strip_first:
        props.ρσ_self_is_this = def():
            output.print('true')

    names = Object.keys(props)
    output.indent()
    # Only define the properties if they were not already defined, which
    # can happen if the function definition is inside a loop, for example.
    output.spaced('if', '(!' + fname + '.' + names[0] + ')', 'Object.defineProperties(' + fname)
    output.comma()
    output.with_block(def():
        for v'var i = 0; i < names.length; i++':
            name = names[i]
            output.indent(), output.spaced(name, ':', '{value:', ''), props[name](), output.print('}')
            if i < names.length - 1:
                output.print(',')
            output.newline()
    )
    output.print(')'), output.end_statement()


def function_definition(self, output, strip_first, as_expression, unnamed):
    # unnamed: emit an anonymous function expression (its .name is set after).
    # A decorated `def fib` must not be a named expression `function fib`:
    # that name would shadow, inside the body, the decorated `fib` that
    # recursive calls are meant to reach (so @lru_cache never saw them).
    as_expression = as_expression or self.is_expression or self.is_anonymous
    if as_expression:
        orig_indent = output.indentation()
        output.set_indentation(output.next_indent())
        output.spaced('(function()', '{'), output.newline()
        output.indent(), output.spaced('var', anonfunc, '='), output.space()
    # Async generators (async def with yield) are emitted as a sync wrapper that
    # returns the async iterator directly (matching Python semantics, where calling
    # an async generator function returns the iterator immediately without await).
    # The inner js_generator is `async function*`. The outer wrapper is sync.
    if self.is_async and not self.is_generator:
        output.print("async"), output.space()
    output.print("function"), output.space()
    self.emit_unnamed = bool(unnamed)
    # A method's name must not shadow a module-level name it refers to:
    # def unpack(self, x): return unpack(x) calls the global unpack
    if self.name and not unnamed and not (is_node_type(self, AST_Method) and refers_to(self, self.name.name)):
        self.name.print(output)

    if self.is_generator:
        inner_decl = 'async function* js_generator' if self.is_async else 'function* js_generator'
        output.print('()'), output.space()
        output.with_block(def():
            output.indent()
            output.print(inner_decl)
            function_args(self.argnames, output, strip_first)
            print_bracketed(self, output, True, function_preamble)
            output.newline()
            output.indent()
            output.spaced('var', 'result', '=', 'js_generator.apply(this,', 'arguments)')
            output.end_statement()
            # Python's generator methods: send() / throw() / close() (asend() /
            # athrow() / aclose() for async generators); see baselib-internal
            output.indent()
            output.print(('ρσ_async_generator_methods' if self.is_async else 'ρσ_generator_methods') + '(result)')
            output.end_statement()
            output.indent()
            output.spaced('return', 'result')
            output.end_statement()
        )
    else:
        function_args(self.argnames, output, strip_first)
        print_bracketed(self, output, True, function_preamble)

    if as_expression:
        output.end_statement()
        if unnamed and self.name:
            output.indent()
            output.print('Object.defineProperty(' + anonfunc + ', "name", {value: ' + JSON.stringify(self.name.name) + ', configurable: true})')
            output.end_statement()
        function_annotation(self, output, strip_first, anonfunc)
        output.indent(), output.spaced('return', anonfunc), output.end_statement()
        output.set_indentation(orig_indent)
        output.indent(), output.print("})()")

def print_function(output):
    self = this
    if self.decorators and self.decorators.length:
        output.print("var")
        output.space()
        output.assign(self.name.name)
        decorate(self.decorators, output, def():function_definition(self, output, False, True, True);)
        output.end_statement()
    else:
        function_definition(self, output, False)
        if not self.is_expression and not self.is_anonymous:
            output.end_statement()
            function_annotation(self, output, False)
# }}}

# Function call {{{

def find_this(expression):
    if is_node_type(expression, AST_Dot):
        return expression.expression
    if not is_node_type(expression, AST_SymbolRef):
        return expression

def print_this(expression, output):
    obj = find_this(expression)
    if obj:
        obj.print(output)
    else:
        output.print('this')

def print_function_call(self, output):
    is_prototype_call = False

    def print_function_name(no_call):
        nonlocal is_prototype_call
        if is_node_type(self, AST_ClassCall):
            # class methods are called through the prototype unless static
            if self.static and not self.bind_this:
                self.class.print(output)
                output.print(".")
                output.print(self.method)
            else:
                # Prototype methods, and classmethods reached through super(),
                # take this as the receiver: Cls.prototype.m.call(this, ...) /
                # Cls.m.call(this, ...)
                is_prototype_call = True
                if self.super_from:
                    # super(): the next class in the MRO that defines the method
                    output.print('ρσ_super_method('), self.super_from.print(output)
                    output.print(', this, ' + JSON.stringify(self.method) + ', ')
                    if self.class:
                        self.class.print(output), output.print('.prototype.' + self.method)
                    else:
                        output.print('undefined')
                    output.print(')')
                else:
                    self.class.print(output)
                    output.print("." if self.static else ".prototype.")
                    output.print(self.method)
                if not no_call:
                    output.print(".call")
        else:
            if not is_repeatable:
                output.print('ρσ_expr_temp')
                if is_node_type(self.expression, AST_Dot):
                    print_getattr(self.expression, output, True)
            else:
                # Bare print(...) → ρσ_print(...) in kwargs/starargs context
                if is_node_type(self.expression, AST_SymbolRef) and self.expression.name is 'print':
                    output.print('ρσ_print')
                else:
                    self.expression.print(output)

    def print_kwargs():
        output.print('ρσ_desugar_kwargs(')
        if has_kwarg_items:
            for i, kwname in enumerate(self.args.kwarg_items):
                if i > 0:
                    output.print(',')
                    output.space()
                kwname.print(output)
            if has_kwarg_formals:
                output.print(',')
                output.space()

        if has_kwarg_formals:
            output.print('{')
            for i, pair in enumerate(self.args.kwargs):
                if i: output.comma()
                # the keyword's Python name (a property key, so even default= is fine)
                output.print_property(pair[0].name)
                output.print(':')
                output.space()
                pair[1].print(output)
            output.print('}')
        output.print(')')

    def print_new(apply):
        output.print('ρσ_interpolate_kwargs_constructor.call(')
        output.print('Object.create('), self.expression.print(output), output.print('.prototype)')
        output.comma()
        output.print('true' if apply else 'false')
        output.comma()

    def do_print_this():
        if not is_repeatable:
            output.print('ρσ_expr_temp')
        else:
            print_this(self.expression, output)
        output.comma()

    def print_positional_args():
        # basic arguments
        i = 0
        while i < self.args.length:
            expr = self.args[i]
            is_first = i is 0
            if not is_first:
                output.print('.concat(')
            if expr.is_array:
                expr.print(output)
                i += 1
            else:
                output.print('[')
                while i < self.args.length and not self.args[i].is_array:
                    self.args[i].print(output)
                    if i + 1 < self.args.length and not self.args[i+1].is_array:
                        output.print(',')
                        output.space()
                    i += 1
                output.print(']')
            if not is_first:
                output.print(')')

    has_kwarg_items = self.args.kwarg_items and self.args.kwarg_items.length
    has_kwarg_formals = self.args.kwargs and self.args.kwargs.length
    has_kwargs = has_kwarg_items or has_kwarg_formals
    is_new = is_node_type(self, AST_New)
    is_repeatable = True

    if is_new and not self.args.length and not has_kwargs and not self.args.starargs:
        output.print('new'), output.space()
        print_function_name()
        return # new A is the same as new A() in javascript

    if not has_kwargs and not self.args.starargs:
        # A simple function call
        if is_new:
            output.print('new'), output.space()
            print_function_name()
            output.with_parens(def():
                for i, a in enumerate(self.args):
                    if i:
                        output.comma()
                    a.print(output)
            )
        elif is_node_type(self.expression, AST_SymbolRef) and self.expression.name is 'print':
            # Bare print(...) → console.log(...) to avoid clobbering window.print
            # Wrap each arg in ρσ_str() so type() and other objects display like Python.
            # The first goes through ρσ_print_flush(), which prepends any partial
            # line left by an earlier print(..., end='').
            output.print('console.log')
            output.with_parens(def():
                if not self.args.length:
                    output.print('ρσ_print_flush("")')
                # several arguments are joined into one string: console.log would
                # treat %s / %d / %j in a first string argument as format directives
                if self.args.length:
                    output.print('ρσ_print_flush(')
                for i, a in enumerate(self.args):
                    if i:
                        output.print(' + " " + ')
                    output.print('ρσ_str(')
                    a.print(output)
                    output.print(')')
                if self.args.length:
                    output.print(')')
            )
        elif (is_node_type(self.expression, AST_SymbolRef) and
              self.expression.name is 'vars' and self.args.length is 0):
            # vars() with no args → vars(this) so it captures the caller's instance
            output.print('ρσ_vars')
            output.with_parens(def():
                output.print('this')
            )
        elif (is_node_type(self.expression, AST_SymbolRef) and
              (self.expression.name is 'eval' or self.expression.name is 'exec') and
              self.args.length >= 1 and is_node_type(self.args[0], AST_String)):
            # Compile-time RapydScript → JS transformation for eval/exec string literals.
            # The RapydScript source string is parsed and compiled to JS now; the emitted
            # call receives the compiled JS string instead of the original RapydScript.
            fn_name = self.expression.name
            source  = self.args[0].value
            inner_ast = ρσ_rs_parse(source, {
                'filename':        '<eval>',
                'module_id':       '__eval__',
                'for_linting':     True,
                'discard_asserts': output.options.discard_asserts,
            })
            inner_os = OutputStream({
                'beautify':        False,
                'js_version':      output.options.js_version,
                'private_scope':   False,
                'write_name':      False,
                'omit_baselib':    True,
                'discard_asserts': output.options.discard_asserts,
            })
            inner_ast.print(inner_os)
            compiled_js = v'inner_os.get().trim()'

            def _print_extra_args():
                for a in self.args.slice(1):
                    output.comma()
                    a.print(output)

            if fn_name is 'eval' and self.args.length is 1:
                # eval("expr") → native direct eval for scope access
                output.print('eval')
                output.with_parens(def():
                    output.print(JSON.stringify(compiled_js))
                )
            elif fn_name is 'eval':
                # eval("expr", globals, locals) → ρσ_eval(compiled_js, globals, locals)
                output.print('ρσ_eval')
                output.with_parens(def():
                    output.print(JSON.stringify(compiled_js))
                    _print_extra_args()
                )
            else:
                # exec("code", ...) → ρσ_exec(compiled_js, ...)
                output.print('ρσ_exec')
                output.with_parens(def():
                    output.print(JSON.stringify(compiled_js))
                    _print_extra_args()
                )
        elif is_node_type(self.expression, AST_SymbolRef) and self.expression.name is 'eval' and self.args.length > 1:
            # eval(dynamic_expr, globals, locals) → ρσ_eval(dynamic_expr, globals, locals)
            # The 1-arg form eval(expr) is left as native JS direct eval for scope access.
            output.print('ρσ_eval')
            output.with_parens(def():
                for i, a in enumerate(self.args):
                    if i:
                        output.comma()
                    a.print(output)
            )
        elif is_node_type(self.expression, AST_SymbolRef) and self.python_truthiness:
            # __call__-aware dispatch when from __python__ import truthiness is active
            output.print('ρσ_callable_call(')
            print_function_name()
            for i, a in enumerate(self.args):
                output.comma()
                a.print(output)
            output.print(')')
        else:
            # Method calls and other complex expressions — keep existing behaviour
            print_function_name()
            output.with_parens(def():
                for i, a in enumerate(self.args):
                    if i:
                        output.comma()
                    a.print(output)
            )
        return

    is_repeatable = is_new or not has_calls(self.expression)
    if not is_repeatable:
        output.assign('(ρσ_expr_temp'), print_this(self.expression, output), output.comma()

    if has_kwargs:
        if is_new:
            print_new(False)
        else:
            output.print('ρσ_interpolate_kwargs.call(')
            do_print_this()
        print_function_name(True)
        output.comma()
    else:
        if is_new:
            print_new(True)
            print_function_name(True)
            output.comma()
        else:
            print_function_name(True)
            output.print('.apply(')
            do_print_this()

    # The receiver (this) was printed above, so drop it from the positional
    # arguments, without changing the AST (it may be printed more than once)
    all_args = self.args
    if is_prototype_call and (all_args.length > 1 or has_kwargs):
        positional = all_args.slice(1)
        positional.kwargs = all_args.kwargs
        positional.kwarg_items = all_args.kwarg_items
        positional.starargs = all_args.starargs
        self.args = positional

    print_positional_args()

    if has_kwargs:
        if self.args.length:
            output.print('.concat(')
        output.print('[')
        print_kwargs()
        output.print(']')
        if self.args.length:
            output.print(')')
    self.args = all_args

    output.print(')')
    if not is_repeatable:
        output.print(')')
# }}}
