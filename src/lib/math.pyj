########################################
# Additions from newer Pythons (3.5 - 3.9)
########################################
def isfinite(x):
    return isFinite(x)

def isclose(a, b, rel_tol=1e-09, abs_tol=0.0):
    if rel_tol < 0 or abs_tol < 0:
        raise ValueError('tolerances must be non-negative')
    if a is b:
        return True
    if isinf(a) or isinf(b):
        return False
    diff = Math.abs(b - a)
    return diff <= Math.abs(rel_tol * b) or diff <= Math.abs(rel_tol * a) or diff <= abs_tol

def _gcd2(a, b):
    a = Math.abs(a)
    b = Math.abs(b)
    while b:
        a, b = b, a % b
    return a

def gcd(*integers):
    ans = 0
    for n in integers:
        ans = _gcd2(ans, n)
    return ans

def lcm(*integers):
    ans = 1
    for n in integers:
        if n is 0:
            return 0
        ans = Math.abs(ans * n) / _gcd2(ans, n)
    return ans

def perm(n, k=None):
    if k is None:
        k = n
    if n < 0 or k < 0:
        raise ValueError('n must be a non-negative integer' if n < 0 else 'k must be a non-negative integer')
    if k > n:
        return 0
    ans = 1
    for i in range(n - k + 1, n + 1):
        ans *= i
    return ans

def comb(n, k):
    if n < 0 or k < 0:
        raise ValueError('n must be a non-negative integer' if n < 0 else 'k must be a non-negative integer')
    if k > n:
        return 0
    k = Math.min(k, n - k)
    ans = 1
    for i in range(1, k + 1):
        ans = ans * (n - k + i) / i
    return Math.round(ans)

def prod(iterable, start=1):
    ans = start
    for x in iterable:
        ans *= x
    return ans
