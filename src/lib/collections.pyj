# vim:fileencoding=utf-8
# License: BSD
# RapydScript implementation of Python's collections standard library.
#
# Supported: namedtuple, deque, Counter, OrderedDict, defaultdict, ChainMap
#
# Note: Counter, OrderedDict, defaultdict, and ChainMap use
# __getitem__/__setitem__. For Python-compatible subscript syntax (obj[key])
# in user code, add:
#   from __python__ import overload_getitem


def namedtuple(typename, field_names, rename=False, defaults=None, module=None):
    """Return a new tuple subclass with named fields, like Python's collections.namedtuple.

    Instances are tuples (len(), indexing, unpacking, ==, isinstance(p, tuple))
    whose fields are also readable by name.
    """
    if isinstance(field_names, str):
        fields = v"field_names.replace(/,/g, ' ').trim().split(/\s+/).filter(function(s){return s.length>0;})"
    else:
        fields = [str(f) for f in field_names]
    seen = v'Object.create(null)'
    for i, f in enumerate(fields):
        bad = not str.isidentifier(f) or str.startswith(f, '_') or seen[f]
        if bad:
            if rename:
                fields[i] = '_' + i
            elif seen[f]:
                raise ValueError('Encountered duplicate field name: ' + repr(f))
            else:
                raise ValueError('Type names and field names must be valid identifiers and cannot start with an underscore: ' + repr(f))
        seen[fields[i]] = True
    n = fields.length
    field_defaults = v'Object.create(null)'
    if defaults is not None:
        defaults = list(defaults)
        if defaults.length > n:
            raise TypeError('Got more default values than field names')
        for i in range(defaults.length):
            field_defaults[fields[n - defaults.length + i]] = defaults[i]

    v"""
    function constructor() {
        var args = Array.prototype.slice.call(arguments), kw = null;
        if (args.length > 0 && args[args.length-1] !== null && typeof args[args.length-1] === 'object' && args[args.length-1][ρσ_kwargs_symbol] === true) {
            kw = args.pop();
        }
        if (args.length > n) throw new TypeError(typename + '() takes ' + n + ' positional arguments but ' + args.length + ' were given');
        var values = new Array(n);
        for (var i = 0; i < n; i++) {
            var f = fields[i];
            if (i < args.length) {
                if (kw && Object.prototype.hasOwnProperty.call(kw, f)) throw new TypeError(typename + "() got multiple values for argument '" + f + "'");
                values[i] = args[i];
            } else if (kw && Object.prototype.hasOwnProperty.call(kw, f)) {
                values[i] = kw[f];
            } else if (Object.prototype.hasOwnProperty.call(field_defaults, f)) {
                values[i] = field_defaults[f];
            } else {
                throw new TypeError(typename + "() missing required argument: '" + f + "'");
            }
        }
        if (kw) {
            for (var k in kw) {
                if (fields.indexOf(k) < 0) throw new TypeError(typename + "() got an unexpected keyword argument '" + k + "'");
            }
        }
        var inst = ρσ_tuple_decorate(values);
        Object.setPrototypeOf(inst, constructor.prototype);
        inst.constructor = constructor;
        inst.toString = inst.inspect = constructor.prototype.__repr__;
        return inst;
    }
    constructor.prototype = Object.create(Array.prototype);
    fields.forEach(function (f, i) {
        Object.defineProperty(constructor.prototype, f, {get: function () { return this[i]; }, configurable: true});
    });
    """

    constructor.__name__ = constructor.__qualname__ = typename
    constructor.__module__ = module or '__main__'
    constructor._fields = tuple(fields)
    constructor.__match_args__ = tuple(fields)
    constructor._field_defaults = dict(field_defaults)
    v'Object.defineProperty(constructor.prototype, "__bases__", {value: [ρσ_tuple_constructor]})'

    constructor.prototype._asdict = def():
        d = dict()
        for i, f in enumerate(fields):
            d.__setitem__(f, this[i])
        return d

    constructor.prototype._replace = def(**kwargs):
        args = []
        for i, f in enumerate(fields):
            if f in kwargs:
                args.push(kwargs[f])
                v'delete kwargs[f]'
            else:
                args.push(this[i])
        extra = Object.keys(kwargs)
        if extra.length:
            raise ValueError('Got unexpected field names: ' + repr(extra))
        return v'constructor.apply(null, args)'

    constructor.prototype.__repr__ = def():
        parts = []
        for i, f in enumerate(fields):
            parts.push(f + '=' + repr(this[i]))
        return typename + '(' + parts.join(', ') + ')'
    constructor.prototype.__str__ = constructor.prototype.__repr__

    constructor.prototype.__getnewargs__ = def():
        return tuple(this)

    constructor._make = def(iterable):
        return v'constructor.apply(null, list(iterable))'

    return constructor

class deque:
    """Double-ended queue with optional maximum length."""

    def __init__(self, iterable=None, maxlen=None):
        v'ρσ_bind_methods(this, Object.prototype)'  # q.append etc. usable as values
        self._data = []
        self._maxlen = maxlen
        if iterable is not None:
            for item in iterable:
                self.append(item)

    @property
    def maxlen(self):
        return self._maxlen

    def _trim_left(self):
        if self._maxlen is not None:
            while len(self._data) > self._maxlen:
                self._data.shift()

    def _trim_right(self):
        if self._maxlen is not None:
            while len(self._data) > self._maxlen:
                self._data.pop()

    def append(self, x):
        self._data.push(x)
        self._trim_left()

    def appendleft(self, x):
        self._data.unshift(x)
        self._trim_right()

    def extend(self, iterable):
        for item in iterable:
            self.append(item)

    def extendleft(self, iterable):
        for item in iterable:
            self.appendleft(item)

    def pop(self):
        if not self._data.length:
            raise IndexError('pop from an empty deque')
        return self._data.pop()

    def popleft(self):
        if not self._data.length:
            raise IndexError('pop from an empty deque')
        return self._data.shift()

    def rotate(self, n=1):
        size = len(self._data)
        if size == 0:
            return
        n = n % size
        if n == 0:
            return
        if n > 0:
            for i in range(n):
                self._data.unshift(self._data.pop())
        else:
            for i in range(-n):
                self._data.push(self._data.shift())

    def clear(self):
        self._data = []

    def copy(self):
        return deque(self._data, self._maxlen)

    def count(self, x):
        c = 0
        for item in self._data:
            if item == x:
                c += 1
        return c

    def remove(self, value):
        for i in range(len(self._data)):
            if self._data[i] == value:
                self._data.splice(i, 1)
                return
        raise ValueError(repr(value) + ' is not in deque')

    def reverse(self):
        self._data.reverse()

    def index(self, x, start=0, stop=None):
        if stop is None:
            stop = len(self._data)
        for i in range(start, stop):
            if self._data[i] == x:
                return i
        raise ValueError(repr(x) + ' is not in deque')

    def insert(self, i, x):
        if self._maxlen is not None and len(self._data) >= self._maxlen:
            raise IndexError('deque already at its maximum size')
        self._data.splice(i, 0, x)

    def __len__(self):
        return self._data.length

    def __getitem__(self, i):
        size = len(self._data)
        if i < 0:
            i += size
        if i < 0 or i >= size:
            raise IndexError('deque index out of range')
        return self._data[i]

    def __setitem__(self, i, value):
        size = len(self._data)
        if i < 0:
            i += size
        if i < 0 or i >= size:
            raise IndexError('deque index out of range')
        self._data[i] = value

    def __contains__(self, x):
        for item in self._data:
            if item == x:
                return True
        return False

    def __iter__(self):
        return iter(self._data)

    def __str__(self):
        return self.__repr__()

    def __repr__(self):
        if self._maxlen is not None:
            return 'deque(' + repr(list(self._data)) + ', maxlen=' + str(self._maxlen) + ')'
        return 'deque(' + repr(list(self._data)) + ')'

    def __eq__(self, other):
        if not isinstance(other, deque):
            return False
        if len(self._data) != len(other._data):
            return False
        for i in range(len(self._data)):
            if self._data[i] != other._data[i]:
                return False
        return True


# Counter, OrderedDict and defaultdict subclass dict, as in Python: they share
# its hash-aware storage (so keys keep their types: Counter([1, 2]) counts the
# ints 1 and 2, and tuples work as keys), its views and its methods, and add
# only their own behaviour.

def _new_dict_store(self):
    self.jsmap = v'new ρσ_dict_implementation()'  # what dict's constructor sets up
    # Methods taken as values stay bound, as in Python: max(c, key=c.get)
    v'ρσ_bind_methods(self, Object.prototype)'


def _items_of(d):
    # [key, value] pairs of a dict, in order
    ans = []
    iterator = d.jsmap.entries()
    r = iterator.next()
    while not r.done:
        ans.push(r.value)
        r = iterator.next()
    return ans


def _dict_body_repr(pairs):
    return '{' + [repr(p[0]) + ': ' + repr(p[1]) for p in pairs].join(', ') + '}'


def _factory_repr(f):
    if f is None or f is undefined:
        return 'None'
    if v'Object.prototype.hasOwnProperty.call(f, "__name__")':
        return "<class '" + f.__name__ + "'>"  # list, int, a user class, ...
    return '<function ' + (f.name or '<lambda>') + '>'


def _equal_to_plain_object(d, other):
    keys = Object.keys(other)
    if keys.length != d.jsmap.size:
        return False
    for k in keys:
        if not d.jsmap.has(k) or d.jsmap.get(k) != other[k]:
            return False
    return True


class Counter(dict):
    """Dict subclass for counting hashable objects."""

    def __init__(self, iterable=None, **kwargs):
        _new_dict_store(self)
        self._count(iterable, kwargs, 1)

    def _add(self, key, n):
        m = self.jsmap
        m.set(key, (m.get(key) or 0) + n)

    def _count(self, iterable, kwargs, sign):
        if iterable is not None and iterable is not undefined:
            if v'iterable instanceof ρσ_dict':
                # a mapping of counts (a Counter or any dict)
                for pair in _items_of(iterable):
                    self._add(pair[0], sign * pair[1])
            elif jstype(iterable) is 'object' and not Array.isArray(iterable) and jstype(iterable[ρσ_iterator_symbol]) is not 'function':
                for k in Object.keys(iterable):  # a plain JS object used as a mapping
                    self._add(k, sign * iterable[k])
            else:
                for item in iterable:
                    self._add(item, sign)
        if kwargs:
            for k in Object.keys(kwargs):
                self._add(k, sign * kwargs[k])

    def __getitem__(self, key):
        # A missing element counts zero (and isn't added), as in Python
        m = self.jsmap
        return m.get(key) if m.has(key) else 0

    def __missing__(self, key):
        return 0

    def update(self, iterable=None, **kwargs):
        self._count(iterable, kwargs, 1)

    def subtract(self, iterable=None, **kwargs):
        self._count(iterable, kwargs, -1)

    def most_common(self, n=None):
        # (element, count) tuples, highest count first; ties keep insertion order
        items = [ρσ_tuple_decorate([p[0], p[1]]) for p in _items_of(self)]
        items.sort(key=def(pair): return -pair[1];)
        if n is not None and n is not undefined:
            return items[:n]
        return items

    def elements(self):
        result = []
        for pair in _items_of(self):
            for i in range(max(0, pair[1])):
                result.push(pair[0])
        return iter(result)

    def total(self):
        s = 0
        for pair in _items_of(self):
            s += pair[1]
        return s

    def copy(self):
        return Counter(self)

    def __str__(self):
        return self.__repr__()

    def __repr__(self):
        if not self.jsmap.size:
            return 'Counter()'
        return 'Counter(' + _dict_body_repr(self.most_common()) + ')'

    def __eq__(self, other):
        # Missing elements count as zero (Python 3.10+)
        if not v'other instanceof ρσ_dict':
            return False
        mine = self.jsmap
        theirs = other.jsmap
        for pair in _items_of(self):
            if pair[1] != (theirs.get(pair[0]) or 0):
                return False
        for pair in _items_of(other):
            if pair[1] != (mine.get(pair[0]) or 0):
                return False
        return True

    def _combine(self, other, op):
        # Counter arithmetic keeps only positive counts
        if not v'other instanceof Counter':
            return NotImplemented
        result = Counter()
        keys = [p[0] for p in _items_of(self)]
        for p in _items_of(other):
            if not self.jsmap.has(p[0]):
                keys.push(p[0])
        for k in keys:
            val = op(self.__getitem__(k), other.__getitem__(k))
            if val > 0:
                result.jsmap.set(k, val)
        return result

    def __add__(self, other):
        return self._combine(other, def(a, b): return a + b;)

    def __sub__(self, other):
        return self._combine(other, def(a, b): return a - b;)

    def __or__(self, other):
        return self._combine(other, def(a, b): return max(a, b);)

    def __and__(self, other):
        return self._combine(other, def(a, b): return min(a, b);)

    def __pos__(self):
        return self._combine(Counter(), def(a, b): return a;)

    def __neg__(self):
        return Counter()._combine(self, def(a, b): return -b;)


class OrderedDict(dict):
    """Dict that remembers insertion order and supports move_to_end / popitem."""

    def __init__(self, iterable=None, **kwargs):
        _new_dict_store(self)
        if iterable is not None and iterable is not undefined:
            ρσ_dict.prototype.update.call(self, iterable)
        if kwargs and Object.keys(kwargs).length:
            ρσ_dict.prototype.update.call(self, kwargs)

    def __getitem__(self, key):
        m = self.jsmap
        if not m.has(key):
            raise KeyError(key)
        return m.get(key)

    def move_to_end(self, key, last=True):
        m = self.jsmap
        if not m.has(key):
            raise KeyError(key)
        val = m.get(key)
        if last:
            m.delete(key)
            m.set(key, val)
        else:
            pairs = _items_of(self)
            m.clear()
            m.set(key, val)
            for p in pairs:
                if not m.has(p[0]):
                    m.set(p[0], p[1])

    def popitem(self, last=True):
        pairs = _items_of(self)
        if not pairs.length:
            raise KeyError('dictionary is empty')
        pair = pairs[pairs.length - 1] if last else pairs[0]
        self.jsmap.delete(pair[0])
        return ρσ_tuple_decorate([pair[0], pair[1]])

    def copy(self):
        return OrderedDict(self)

    def __str__(self):
        return self.__repr__()

    def __repr__(self):
        pairs = ['(' + repr(p[0]) + ', ' + repr(p[1]) + ')' for p in _items_of(self)]
        return 'OrderedDict([' + pairs.join(', ') + '])'

    def __eq__(self, other):
        # Order matters between OrderedDicts, not against a plain dict
        if v'other instanceof OrderedDict':
            a = _items_of(self)
            b = _items_of(other)
            if a.length != b.length:
                return False
            for i in range(a.length):
                if a[i][0] != b[i][0] or a[i][1] != b[i][1]:
                    return False
            return True
        if v'other instanceof ρσ_dict':
            return ρσ_dict.prototype.__eq__.call(self, other)
        if jstype(other) is 'object' and other is not None and not Array.isArray(other):
            return _equal_to_plain_object(self, other)
        return False

    @classmethod
    def fromkeys(cls, keys, value=None):
        od = cls()
        for k in keys:
            od.jsmap.set(k, value)
        return od


class defaultdict(dict):
    """Dict subclass that calls a factory for missing keys."""

    def __init__(self, default_factory=None, iterable=None, **kwargs):
        _new_dict_store(self)
        self.default_factory = default_factory
        if iterable is not None and iterable is not undefined:
            ρσ_dict.prototype.update.call(self, iterable)
        if kwargs and Object.keys(kwargs).length:
            ρσ_dict.prototype.update.call(self, kwargs)

    def __missing__(self, key):
        if self.default_factory is None or self.default_factory is undefined:
            raise KeyError(key)
        val = self.default_factory()
        self.jsmap.set(key, val)
        return val

    def __getitem__(self, key):
        m = self.jsmap
        if m.has(key):
            return m.get(key)
        return self.__missing__(key)

    def copy(self):
        return defaultdict(self.default_factory, self)

    def __str__(self):
        return self.__repr__()

    def __repr__(self):
        return 'defaultdict(' + _factory_repr(self.default_factory) + ', ' + _dict_body_repr(_items_of(self)) + ')'

    def __eq__(self, other):
        if v'other instanceof ρσ_dict':
            return ρσ_dict.prototype.__eq__.call(self, other)
        if jstype(other) is 'object' and other is not None and not Array.isArray(other):
            return _equal_to_plain_object(self, other)
        return False


class ChainMap:
    """Combine several mappings into a single, updateable view.

    Lookups search the underlying mappings in order, so the first mapping
    wins. Writes, updates, and deletions affect only the first mapping.
    Mirrors Python's collections.ChainMap.
    """

    def __init__(self, *maps):
        if maps.length == 0:
            self.maps = [{}]
        else:
            self.maps = list(maps)

    # ── internal mapping-access helpers ───────────────────────────────────
    # A "map" may be a plain JS object, a RapydScript dict (ρσ_dict, used for
    # {...} literals in the web-repl), or any RapydScript mapping defining
    # __getitem__/__setitem__/__contains__ (OrderedDict, defaultdict, Counter,
    # or a nested ChainMap).

    def _is_rdict(self, m):
        return v'!!(m && m.jsmap && typeof m.jsmap.get === "function")'

    def _is_mapping(self, m):
        return v'!!(m && typeof m.__getitem__ === "function" && typeof m.__contains__ === "function")'

    def _mkeys(self, m):
        if self._is_rdict(m):
            return v'Array.from(m.jsmap.keys())'
        if self._is_mapping(m):
            return list(m.keys())
        return Object.keys(m)

    def _mhas(self, m, key):
        if self._is_rdict(m):
            return v'm.jsmap.has(key)'
        if self._is_mapping(m):
            return m.__contains__(key)
        return v'Object.prototype.hasOwnProperty.call(m, key)'

    def _mget(self, m, key):
        if self._is_rdict(m):
            return v'm.jsmap.get(key)'
        if self._is_mapping(m):
            return m.__getitem__(key)
        return v'm[key]'

    def _mset(self, m, key, value):
        if self._is_rdict(m):
            v'm.jsmap.set(key, value)'
        elif self._is_mapping(m):
            m.__setitem__(key, value)
        else:
            v'm[key] = value'

    def _mdel(self, m, key):
        if self._is_rdict(m):
            v'm.jsmap["delete"](key)'
        elif self._is_mapping(m):
            m.__delitem__(key)
        else:
            v'delete m[key]'

    def _all_keys(self):
        # Unique keys across every map. Maps are scanned last-to-first so that
        # earlier maps keep their key positions, matching Python's iteration.
        seen = v'Object.create(null)'
        result = []
        i = self.maps.length - 1
        while i >= 0:
            for k in self._mkeys(self.maps[i]):
                if k not in seen:
                    seen[k] = True
                    result.push(k)
            i -= 1
        return result

    def __getitem__(self, key):
        for m in self.maps:
            if self._mhas(m, key):
                return self._mget(m, key)
        raise KeyError(repr(key))

    def __setitem__(self, key, value):
        self._mset(self.maps[0], key, value)

    def __delitem__(self, key):
        if not self._mhas(self.maps[0], key):
            raise KeyError('Key not found in the first mapping: ' + repr(key))
        self._mdel(self.maps[0], key)

    def __contains__(self, key):
        for m in self.maps:
            if self._mhas(m, key):
                return True
        return False

    def __len__(self):
        return self._all_keys().length

    def __iter__(self):
        return iter(self._all_keys())

    def __bool__(self):
        for m in self.maps:
            if self._mkeys(m).length > 0:
                return True
        return False

    def _map_repr(self, m):
        pairs = [repr(k) + ': ' + repr(self._mget(m, k)) for k in self._mkeys(m)]
        return '{' + pairs.join(', ') + '}'

    def __str__(self):
        return self.__repr__()

    def __repr__(self):
        parts = [self._map_repr(m) for m in self.maps]
        return 'ChainMap(' + parts.join(', ') + ')'

    def __eq__(self, other):
        if other is None:
            return False
        is_mapish = self._is_rdict(other) or self._is_mapping(other) or (jstype(other) is 'object' and not Array.isArray(other))
        if not is_mapish:
            return False
        a = self._all_keys()
        b = self._mkeys(other)
        if a.length != b.length:
            return False
        for k in a:
            if not self._mhas(other, k):
                return False
            if self.__getitem__(k) != self._mget(other, k):
                return False
        return True

    def get(self, key, dflt=None):
        if self.__contains__(key):
            return self.__getitem__(key)
        return dflt

    def keys(self):
        return self._all_keys()

    def values(self):
        return [self.__getitem__(k) for k in self._all_keys()]

    def items(self):
        return [[k, self.__getitem__(k)] for k in self._all_keys()]

    @property
    def parents(self):
        cm = ChainMap()
        cm.maps = self.maps.slice(1)
        return cm

    def new_child(self, m=None):
        if m is None:
            m = {}
        cm = ChainMap()
        cm.maps = [m].concat(self.maps)
        return cm

    def _copy_map(self, m):
        if jstype(m.copy) is 'function':
            return m.copy()
        result = {}
        for k in Object.keys(m):
            result[k] = m[k]
        return result

    def copy(self):
        cm = ChainMap()
        cm.maps = [self._copy_map(self.maps[0])].concat(self.maps.slice(1))
        return cm

    def pop(self, key, *rest):
        first = self.maps[0]
        if self._mhas(first, key):
            val = self._mget(first, key)
            self._mdel(first, key)
            return val
        if len(rest) > 0:
            return rest[0]
        raise KeyError('Key not found in the first mapping: ' + repr(key))

    def popitem(self):
        first = self.maps[0]
        keys = self._mkeys(first)
        if keys.length == 0:
            raise KeyError('No keys found in the first mapping.')
        k = keys[keys.length - 1]
        val = self._mget(first, k)
        self._mdel(first, k)
        return [k, val]

    def setdefault(self, key, dflt=None):
        if not self.__contains__(key):
            self._mset(self.maps[0], key, dflt)
        return self.__getitem__(key)

    def clear(self):
        first = self.maps[0]
        if jstype(first.clear) is 'function':
            first.clear()
        else:
            for k in Object.keys(first):
                v'delete first[k]'

    def update(self, other=None, **kwargs):
        first = self.maps[0]
        if other is not None:
            if self._is_rdict(other) or self._is_mapping(other):
                for k in self._mkeys(other):
                    self._mset(first, k, self._mget(other, k))
            elif jstype(other) is 'object' and not Array.isArray(other):
                for k in Object.keys(other):
                    self._mset(first, k, other[k])
            else:
                for pair in other:
                    self._mset(first, pair[0], pair[1])
        for k in kwargs:
            self._mset(first, k, kwargs[k])
