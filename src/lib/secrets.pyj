###########################################################
# Implementation of Python's 'secrets' module.
#
# Supported:
#   token_bytes(nbytes=None), token_hex(nbytes=None), token_urlsafe(nbytes=None)
#   choice(seq), randbelow(n), randbits(k), compare_digest(a, b)
#   SystemRandom — random(), randrange(), randint(), choice(), shuffle(),
#                  sample(), uniform(), getrandbits(), choices()
#   DEFAULT_ENTROPY (32 bytes)
#
# Randomness comes from crypto.getRandomValues (browsers, Node 19+, Deno,
# workers) or, failing that, require('crypto').randomBytes (older Node).  If
# neither is available a RuntimeError is raised — secrets never falls back to
# Math.random().

DEFAULT_ENTROPY = 32


def _crypto_source():
    v'if (typeof globalThis !== "undefined" && globalThis.crypto && typeof globalThis.crypto.getRandomValues === "function") return function(buf) { for (var off = 0; off < buf.length; off += 65536) globalThis.crypto.getRandomValues(buf.subarray(off, Math.min(buf.length, off + 65536))); }'
    v'if (typeof crypto !== "undefined" && crypto && typeof crypto.getRandomValues === "function") return function(buf) { for (var off = 0; off < buf.length; off += 65536) crypto.getRandomValues(buf.subarray(off, Math.min(buf.length, off + 65536))); }'
    v'if (typeof require === "function") { try { var nc = require("crypto"); if (nc && typeof nc.randomFillSync === "function") return function(buf) { nc.randomFillSync(buf); }; if (nc && typeof nc.randomBytes === "function") return function(buf) { var b = nc.randomBytes(buf.length); for (var i = 0; i < buf.length; i++) buf[i] = b[i]; }; } catch (e) {} }'
    return None


_fill = _crypto_source()


def _random_u8(n):
    if not _fill:
        raise RuntimeError('No cryptographically secure random source is available in this environment')
    buf = v'new Uint8Array(n)'
    if n > 0:
        _fill(buf)
    return buf


def _check_nbytes(nbytes):
    if nbytes is None or nbytes is undefined:
        return DEFAULT_ENTROPY
    if jstype(nbytes) is not 'number' or not Number.isInteger(nbytes):
        raise TypeError("'" + jstype(nbytes) + "' object cannot be interpreted as an integer")
    if nbytes < 0:
        raise ValueError('negative argument not allowed')
    return nbytes


def token_bytes(nbytes=None):
    return bytes(_random_u8(_check_nbytes(nbytes)))


def token_hex(nbytes=None):
    u8 = _random_u8(_check_nbytes(nbytes))
    out = []
    for i in range(u8.length):
        out.push((u8[i] + 0x100).toString(16).slice(1))
    return out.join('')


_B64URL = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_'


def token_urlsafe(nbytes=None):
    # base64url without padding, as Python produces
    u8 = _random_u8(_check_nbytes(nbytes))
    out = []
    i = 0
    while i < u8.length:
        b0 = u8[i]
        b1 = u8[i + 1] if i + 1 < u8.length else 0
        b2 = u8[i + 2] if i + 2 < u8.length else 0
        out.push(_B64URL[b0 >> 2])
        out.push(_B64URL[((b0 & 3) << 4) | (b1 >> 4)])
        if i + 1 < u8.length:
            out.push(_B64URL[((b1 & 15) << 2) | (b2 >> 6)])
        if i + 2 < u8.length:
            out.push(_B64URL[b2 & 63])
        i += 3
    return out.join('')


def randbits(k):
    if jstype(k) is not 'number' or not Number.isInteger(k):
        raise TypeError('an integer is required')
    if k < 0:
        raise ValueError('number of bits must be non-negative')
    if k is 0:
        return 0
    nbytes = Math.ceil(k / 8)
    u8 = _random_u8(nbytes)
    extra = nbytes * 8 - k
    u8[0] &= (0xff >> extra)
    if k <= 53:
        n = 0
        for i in range(nbytes):
            n = n * 256 + u8[i]
        return n
    big = v'BigInt(0)'
    for i in range(nbytes):
        big = v'(big << BigInt(8)) | BigInt(u8[i])'
    return big


def randbelow(exclusive_upper_bound):
    n = exclusive_upper_bound
    if jstype(n) is not 'number' or not Number.isInteger(n):
        raise TypeError('an integer is required')
    if n <= 0:
        raise ValueError('Upper bound must be positive.')
    if n is 1:
        return 0
    k = Math.ceil(Math.log2(n))
    if Math.pow(2, k) < n:
        k += 1
    while True:  # rejection sampling: no modulo bias
        r = randbits(k)
        if r < n:
            return r


def choice(seq):
    if seq is None or seq is undefined:
        raise TypeError("'NoneType' object is not subscriptable")
    n = len(seq)
    if n is 0:
        raise IndexError('Cannot choose from an empty sequence')
    i = randbelow(n)
    if jstype(seq) is 'string' or Array.isArray(seq):
        return seq[i]
    if jstype(seq.__getitem__) is 'function':
        return seq.__getitem__(i)
    return list(seq)[i]


def _bytes_of(x):
    if jstype(x) is 'string':
        for i in range(x.length):
            if x.charCodeAt(i) > 127:
                raise TypeError('comparing strings with non-ASCII characters is not supported')
        return [x.charCodeAt(i) for i in range(x.length)]
    if x and Array.isArray(x._data):
        return x._data
    if v'x instanceof Uint8Array' or Array.isArray(x):
        return x
    raise TypeError("unsupported operand types(s) or combination of types: '" + jstype(x) + "'")


def compare_digest(a, b):
    if (jstype(a) is 'string') is not (jstype(b) is 'string'):
        raise TypeError("unsupported operand types(s) or combination of types: '" + jstype(a) + "' and '" + jstype(b) + "'")
    x = _bytes_of(a)
    y = _bytes_of(b)
    # Constant time with respect to the contents (and to the length of b).
    result = 0 if x.length is y.length else 1
    for i in range(y.length):
        result |= (x[i % Math.max(x.length, 1)] or 0) ^ y[i]
    return result is 0


_choice = choice  # SystemRandom.choice would shadow choice() inside its body


class SystemRandom:

    def __init__(self, x=None):
        pass

    def seed(self, *args):
        return None

    def getstate(self):
        raise NotImplementedError('System entropy source does not have state.')

    def setstate(self, state):
        raise NotImplementedError('System entropy source does not have state.')

    def random(self):
        # 53 random bits -> float in [0, 1)
        return randbits(53) / 9007199254740992

    def getrandbits(self, k):
        return randbits(k)

    def randbytes(self, n):
        return token_bytes(n)

    def randrange(self, start, stop=None, step=1):
        if stop is None or stop is undefined:
            if start <= 0:
                raise ValueError('empty range for randrange()')
            return randbelow(start)
        width = stop - start
        if step is 1:
            if width <= 0:
                raise ValueError('empty range for randrange() (' + start + ', ' + stop + ', ' + width + ')')
            return start + randbelow(width)
        if step is 0:
            raise ValueError('zero step for randrange()')
        n = Math.ceil(width / step) if step > 0 else Math.ceil(width / step)
        if n <= 0:
            raise ValueError('empty range for randrange()')
        return start + step * randbelow(n)

    def randint(self, a, b):
        return self.randrange(a, b + 1)

    def choice(self, seq):
        return _choice(seq)

    def choices(self, population, weights=None, cum_weights=None, k=1):
        pop = list(population)
        n = pop.length
        if weights is None and cum_weights is None:
            return [pop[randbelow(n)] for _ in range(k)]
        if cum_weights is None:
            cum_weights = []
            total = 0
            for w in weights:
                total += w
                cum_weights.push(total)
        total = cum_weights[cum_weights.length - 1]
        ans = []
        for _ in range(k):
            r = self.random() * total
            lo, hi = 0, n - 1
            while lo < hi:
                mid = (lo + hi) >> 1
                if r < cum_weights[mid]:
                    hi = mid
                else:
                    lo = mid + 1
            ans.push(pop[lo])
        return ans

    def shuffle(self, x):
        i = x.length - 1
        while i > 0:
            j = randbelow(i + 1)
            tmp = x[i]
            x[i] = x[j]
            x[j] = tmp
            i -= 1

    def sample(self, population, k):
        pool = list(population)
        n = pool.length
        if k < 0 or k > n:
            raise ValueError('Sample larger than population or is negative')
        ans = []
        for i in range(k):
            j = i + randbelow(n - i)
            tmp = pool[i]
            pool[i] = pool[j]
            pool[j] = tmp
            ans.push(pool[i])
        return ans

    def uniform(self, a, b):
        return a + (b - a) * self.random()
