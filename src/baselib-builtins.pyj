        lookup = name
    else:
        lookup = name.split('.')[0]
    module = ρσ_modules[lookup]
    if module is undefined:
        raise ModuleNotFoundError('No module named \'' + lookup + '\'')
    return module

def ρσ_pow(x, y, z):
    ans = Math.pow(x, y)
    if z is not undefined:
