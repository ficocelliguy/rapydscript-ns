        return ρσ_range(start + (length - 1) * step, start - step, -step)
    ans.__repr__ = def():
        return f'range({start}, {stop})' if step is 1 else f'range({start}, {stop}, {step})'
    ans.__str__ = ans.toString = ans.__repr__
