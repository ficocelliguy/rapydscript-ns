def ρσ_bool(val):
    # Python truthiness — written entirely with verbatim JS so that the
    # compiled ρσ_bool function never calls itself (no bootstrap recursion).
    v'if (val === null || val === undefined) return false'
    v'var ρσ_bool_t = typeof val'
    v'if (ρσ_bool_t === "boolean") return val'
    v'if (ρσ_bool_t === "number") return val !== 0'
    v'if (ρσ_bool_t === "string") return val.length > 0'
    v'if (ρσ_bool_t === "function") return true'
    v'if (val.constructor && val.constructor.prototype === val) return true'
    v'if (typeof val.__bool__ === "function") return !!val.__bool__()'
    v'if (Array.isArray(val)) return val.length > 0'
    v'if (typeof val.__len__ === "function") return val.__len__() > 0'
    v'if ((typeof Set === "function" && val instanceof Set) || (typeof Map === "function" && val instanceof Map)) return val.size > 0'
    v'if (!val.constructor || val.constructor === Object) return Object.keys(val).length > 0'
    return True
ρσ_bool.__name__ = 'bool'

# A JS console can only write whole lines, so text printed with an `end` that
# isn't a newline (print('.', end='')) waits here and starts the next line
# printed. If nothing follows, it is printed once the currently running code
# finishes (a microtask), so a trailing partial line is never lost.
v'var ρσ_print_pending = "", ρσ_print_scheduled = false'

def ρσ_print_flush(first):
    # Called by every compiled print(): prepends any pending partial line.
    if v'ρσ_print_pending === ""':
        return first
    ans = ρσ_print_pending + first
    v'ρσ_print_pending = ""'
    return ans

def ρσ_print_flush_pending():
    v'ρσ_print_scheduled = false'
    if v'ρσ_print_pending !== ""' and v'typeof console' is 'object':
        console.log(ρσ_print_flush(''))

def ρσ_print(*args, **kwargs):
    sep = ' ' if kwargs.sep is undefined or kwargs.sep is None else kwargs.sep
    end = '\n' if kwargs.end is undefined or kwargs.end is None else kwargs.end
    parts = [ρσ_str(a) for a in args]
    text = parts.join(sep) + end
    out = kwargs.file
    if out is not undefined and out is not None and jstype(out.write) is 'function':
        out.write(text)  # print(..., file=buf)
        return
    if v'typeof console' is not 'object':
        return
    text = ρσ_print_flush(text)
    nl = text.lastIndexOf('\n')
    if nl >= 0:
        console.log(text.slice(0, nl))
    v'ρσ_print_pending = text.slice(nl + 1)'
    if v'ρσ_print_pending !== "" && !ρσ_print_scheduled':
        v'ρσ_print_scheduled = true'
        if v'typeof Promise === "function"':
            v'Promise.resolve().then(ρσ_print_flush_pending)'
        elif v'typeof setTimeout === "function"':
            v'setTimeout(ρσ_print_flush_pending, 0)'
        else:
            ρσ_print_flush_pending()  # no way to defer in this host: emit it now

def ρσ_int(val, base):
    if val is undefined:
        return 0  # int() is 0, which is what defaultdict(int) relies on
    if jstype(val) is "number":
        if not isFinite(val):
            if isNaN(val):
                raise ValueError('cannot convert float NaN to integer')
            raise OverflowError('cannot convert float infinity to integer')
        # Math.trunc, not `val | 0`, which wraps anything past 32 bits
        ans = Math.trunc(val)
    elif val is not None and jstype(val.__int__) is 'function' and (base is None or base is undefined):
        return val.__int__()
    elif jstype(val) is 'boolean':
        return 1 if val else 0
    else:
        ans = ρσ_parse_int_literal(val, 10 if base is undefined or base is None else base)
    return ans

def ρσ_parse_int_literal(val, base):
    # Python's int(str, base): whitespace, a sign, `_` between digits, and a
    # 0x / 0o / 0b prefix for that base (any of them with base 0). parseInt alone
    # would accept '12abc' and '3.5'.
    if base is not 0 and (base < 2 or base > 36):
        raise ValueError('int() base must be >= 2 and <= 36, or 0')
    given_base = base
    s = (val + '').trim()
    m = v'/^([+-]?)(?:0([xob])_?)?([0-9a-z]+(?:_[0-9a-z]+)*)$/i'.exec(s)
    ok = m is not None
    if ok:
        prefix = m[2].toLowerCase() if m[2] else ''
        prefix_base = {'x': 16, 'o': 8, 'b': 2}[prefix] if prefix else 0
        if base is 0:
            if prefix_base:
                base = prefix_base
            else:
                base = 10
                ok = v'/^(0+|[1-9][0-9]*)$/'.test(m[3].replace(v'/_/g', ''))  # no leading zeros
        elif prefix_base and prefix_base is not base:
            ok = False
    if ok:
        digits = m[3].replace(v'/_/g', '').toLowerCase()
        valid = '0123456789abcdefghijklmnopqrstuvwxyz'.slice(0, base)
        for v'var i = 0; i < digits.length; i++':
            if valid.indexOf(digits[i]) is -1:
                ok = False
                break
    if not ok:
        raise ValueError('invalid literal for int() with base ' + given_base + ': ' + ρσ_repr(val + ''))
    ans = parseInt(digits, base)
    return -ans if m[1] is '-' else ans
ρσ_int.__name__ = 'int'

def ρσ_float(val):
    if val is undefined:
        return 0.0
    if jstype(val) is "number":
        ans = val
    elif val is not None and jstype(val.__float__) is 'function':
        return val.__float__()
    elif jstype(val) is 'boolean':
        return 1.0 if val else 0.0
    else:
        s = (val + '').trim()
        lower = s.toLowerCase()
        if lower is 'inf' or lower is '+inf' or lower is 'infinity' or lower is '+infinity':
            return v'Infinity'
        if lower is '-inf' or lower is '-infinity':
            return v'-Infinity'
        if lower is 'nan' or lower is '+nan' or lower is '-nan':
            return v'NaN'
        # Python's float literal grammar; parseFloat alone would accept '1.5abc'
        if not v'/^[+-]?(?:\d(?:_?\d)*(?:\.(?:\d(?:_?\d)*)?)?|\.\d(?:_?\d)*)(?:e[+-]?\d(?:_?\d)*)?$/i'.test(s):
            raise ValueError('could not convert string to float: ' + ρσ_repr(val + ''))
        ans = parseFloat(s.replace(v'/_/g', ''))
    return ans
ρσ_float.__name__ = 'float'

def ρσ_long(val, base):
    t = jstype(val)
    if t is 'bigint':
        return val
    if t is 'boolean':
        return v'BigInt(val ? 1 : 0)'
    if t is 'number':
        if not Number.isInteger(val):
            raise TypeError("long() can't convert non-integer float to long")
        v'try { return BigInt(val); } catch(e) { throw new ValueError("long() argument out of range: " + val); }'
    if t is 'string':
        b = base if (base is not None and base is not undefined) else 10
        v'var ρσ_ls = val.trim()'
        try:
            if b is 16:
                if v'ρσ_ls.slice(0, 2).toLowerCase()' is not '0x':
                    v'ρσ_ls = "0x" + ρσ_ls'
                return v'BigInt(ρσ_ls)'
            elif b is 2:
                if v'ρσ_ls.slice(0, 2).toLowerCase()' is not '0b':
                    v'ρσ_ls = "0b" + ρσ_ls'
                return v'BigInt(ρσ_ls)'
            elif b is 8:
                if v'ρσ_ls.slice(0, 2).toLowerCase()' is not '0o':
                    v'ρσ_ls = "0o" + ρσ_ls'
                return v'BigInt(ρσ_ls)'
            else:
                return v'BigInt(ρσ_ls)'
        except:
            raise ValueError('Invalid literal for long() with base ' + b + ': ' + val)
    raise TypeError("long() argument must be a string, a number, or a boolean, not '" + t + "'")
ρσ_long.__name__ = 'long'

def ρσ_arraylike_creator():
    names = 'Int8Array Uint8Array Uint8ClampedArray Int16Array Uint16Array Int32Array Uint32Array Float32Array Float64Array'.split(' ')
    if jstype(HTMLCollection) is 'function':
        names = names.concat('HTMLCollection NodeList NamedNodeMap TouchList'.split(' '))
    return def(x):
        if Array.isArray(x) or v'typeof x' is 'string' or names.indexOf(Object.prototype.toString.call(x).slice(8, -1)) > -1:
            return True
        return False

def options_object(f):
    return def():
        if v'typeof arguments[arguments.length - 1] === "object"':
            arguments[arguments.length - 1][ρσ_kwargs_symbol] = True
        return f.apply(this, arguments)

v'var ρσ_id_map = typeof WeakMap === "function" ? new WeakMap() : null, ρσ_id_counter = 0'

def ρσ_id(x):
    # A unique, stable id per live object (lists, dicts and functions included,
    # which have no ρσ_object_id); equal primitives share one, like small ints.
    if v'x !== null && (typeof x === "object" || typeof x === "function")':
        if x.ρσ_object_id is not undefined:
            return x.ρσ_object_id
        if ρσ_id_map:
            ans = ρσ_id_map.get(x)
            if ans is undefined:
                ans = v'0x40000000 + (++ρσ_id_counter)'  # clear of ρσ_object_id values
                ρσ_id_map.set(x, ans)
            return ans
    return ρσ_hash(x)

def ρσ_dir(item):
    # TODO: this isn't really representative of real Python's dir(), nor is it
    # an intuitive replacement for "for ... in" loop, need to update this logic
    # and introduce a different way of achieving "for ... in"
    arr = []
    for v'var i in item': arr.push(i)  # noqa:undef
    return arr

def ρσ_ord(x):
    ans = x.charCodeAt(0)
    if 0xD800 <= ans <= 0xDBFF:
        second = x.charCodeAt(1)
        if 0xDC00 <= second <= 0xDFFF:
            return (ans - 0xD800) * 0x400 + second - 0xDC00 + 0x10000
        raise TypeError('string is missing the low surrogate char')
    return ans

def ρσ_chr(code):
    if code <= 0xFFFF:
        return String.fromCharCode(code)
    code -= 0x10000
    return String.fromCharCode(0xD800+(code>>10), 0xDC00+(code&0x3FF))

def ρσ_callable(x):
    return v'typeof x === "function" || (x !== null && x !== undefined && typeof x.__call__ === "function")'

def ρσ_callable_call(fn):
    # Dispatch fn(args): check __call__ first (callable objects), then direct call.
    # __call__ is checked first so callable objects (not functions) are dispatched correctly.
    args = v'Array.prototype.slice.call(arguments, 1)'
    if v'fn !== null && fn !== undefined && typeof fn.__call__ === "function"':
        return v'fn.__call__.apply(fn, args)'
    if v'typeof fn === "function"':
        return v'fn.apply(undefined, args)'
    raise TypeError('object is not callable')


def ρσ_to_fixed(x, n):
    # x.toFixed(n), but an exact tie rounds to the even digit as Python does:
    # format(2.5, '.0f') is '2' and round(0.125, 2) is 0.12. toFixed rounds the
    # exact binary value (so 2.675 -> '2.67' already) but sends ties away from zero.
    s = x.toFixed(n)
    if not isFinite(x) or Math.abs(x) >= 1e21:
        return s
    exact = x.toFixed(Math.min(100, n + 60))  # far enough to tell an exact tie
    dot = exact.indexOf('.')
    if not v'/^50*$/'.test(exact.slice(dot + 1 + n)):
        return s
    kept = exact.slice(0, dot + (1 + n if n else 0))  # truncated toward zero
    return kept if (kept.charCodeAt(kept.length - 1) - 48) % 2 is 0 else s

def ρσ_round(x, ndigits):
    if x is not None and jstype(x.__round__) is 'function':
        return x.__round__(ndigits if ndigits is not undefined else None)
    if jstype(x) is not 'number' or not isFinite(x):
        return x
    if ndigits is undefined or ndigits is None:
        ndigits = 0
    if ndigits >= 0:
        return Number(ρσ_to_fixed(x, Math.min(ndigits, 100)))
    factor = Math.pow(10, -ndigits)  # round(1250, -2) == 1200
    return Number(ρσ_to_fixed(x / factor, 0)) * factor

def ρσ_bin(x):
    if jstype(x) is not 'number' or x % 1 is not 0:
        raise TypeError('integer required')
    ans = x.toString(2)
    if ans[0] is '-':
        ans = '-' + '0b' + ans[1:]
    else:
        ans = '0b' + ans
    return ans

def ρσ_hex(x):
    if jstype(x) is not 'number' or x % 1 is not 0:
        raise TypeError('integer required')
    ans = x.toString(16)
    if ans[0] is '-':
        ans = '-' + '0x' + ans[1:]
    else:
        ans = '0x' + ans
    return ans

def ρσ_oct(x):
    if jstype(x) is not 'number' or x % 1 is not 0:
        raise TypeError('integer required')
    ans = x.toString(8)
    if ans[0] is '-':
        ans = '-' + '0o' + ans[1:]
    else:
        ans = '0o' + ans
    return ans

