ok(isinstance(list(zip('a', 'b'))[0], tuple))
ok(isinstance(divmod(7, 2), tuple))
ok(isinstance(str.partition('a=b', '='), tuple))
ok(isinstance((1, 2, 3)[1:], tuple))
ae(repr(set()), 'set()')
same(sorted({1, 2}.union([3], (4,))), [1, 2, 3, 4])
ok({1, 2}.issubset([1, 2, 3]))
ae(str.zfill('-42', 6), '-00042')
ae(str.count('abc', ''), 4)
ae(str.translate('hello', str.maketrans('el', 'ip')), 'hippo')
ok(str.isalpha('héllo'))
same(str.splitlines('a\nb\n', True), ['a\n', 'b\n'])
ae(str.casefold('Straße'), 'strasse')
ae(ascii('é'), "'\\xe9'")
ae(SystemExit(3).code, 3)

from collections import namedtuple
NPoint = namedtuple('NPoint', 'x y', defaults=[0])
np = NPoint(1)
ae(len(np), 2)
ok(isinstance(np, tuple))
ok(np == (1, 0))
ae(repr(np._replace(y=5)), 'NPoint(x=1, y=5)')
ae(NPoint(y=3, x=2).y, 3)

class ObjDict:
    def __init__(self):
        self.a = 1
od = ObjDict()
od.__dict__.update({'b': 2})
ae(od.b, 2)

# ── unbound names: del → NameError, read before assignment → UnboundLocalError
ub_x = 1
del ub_x
assrt.throws(def(): print(ub_x);, NameError)
ub_x = 2
ae(ub_x, 2)

def ub_local():
    try:
        return ub_g
    except UnboundLocalError:
        return 'unbound'
    ub_g = 3
ae(ub_local(), 'unbound')

def ub_del_twice():
    v = 1
    del v
    try:
        del v
    except UnboundLocalError:
        return 'raised'
ae(ub_del_twice(), 'raised')

def ub_loop():
    total = 0
    for i in range(3):
        if i > 0:
            total += prev
        prev = i
    return total
ae(ub_loop(), 1)

# ── builtin methods read as values keep their receiver ─────────────────────
bm_list = []
bm_add = bm_list.append
bm_add(1)
same(bm_list, [1])
bm_nums = [3, 1, 2]
bm_sort = bm_nums.sort
bm_sort()
same(bm_nums, [1, 2, 3])
bm_set = set()
bm_set_add = bm_set.add
bm_set_add(4)
ok(4 in bm_set)
class BmData:
    def __init__(self):
        self.count = 0
bmd = BmData()
bmd.count, bmd.index = 5, 6
ae(bmd.count + bmd.index, 11)

# ── metaclass __call__ ──────────────────────────────────────────────────────
class SingletonMeta(type):
    _instances = dict()  # this file doesn't enable dict_literals, so {} would be a JS object
    def __call__(cls, *args, **kwargs):
        if cls not in cls._instances:
            cls._instances[cls] = super().__call__(*args, **kwargs)
        return cls._instances[cls]
class OneConfig(metaclass=SingletonMeta):
    def __init__(self, name='default'):
        self.name = name
oc1 = OneConfig('first')
ok(OneConfig('second') is oc1)
ae(oc1.name, 'first')

