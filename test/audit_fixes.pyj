class NsCls:
    x = 1
    def m(self):
        pass
ok('x' in NsCls.__dict__ and 'm' in NsCls.__dict__)
assrt.throws(def(): NsCls.__dict__['y'] = 1;, TypeError)
ae(format('a', '5'), 'a    ')
ae(format(7, '5'), '    7')
ae(format('a', '05'), 'a0000')
ae(repr(v'String.fromCharCode(11)'), "'\\x0b'")
ae(getattr(3, 'nope', 'dflt'), 'dflt')
ok(not hasattr(3, 'nope'))
